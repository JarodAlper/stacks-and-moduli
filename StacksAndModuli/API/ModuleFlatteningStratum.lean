module

public import StacksAndModuli.API.ModuleGeneratedByLocus
public import Mathlib.AlgebraicGeometry.Morphisms.Immersion

/-!
# The flattening stratum over an affine base, as an immersion

Let `M` be a module over `R` and `r : ℕ`.  Over a basic open `D(f)` on which `M` becomes
generated by `r` elements `g`, the locus where `M` is flat of constant rank `r` is the closed
subscheme cut out by the relation ideal of the induced presentation
(`Module.freeRankLocus`).  Composing that closed immersion with the open immersion
`D(f) ↪ Spec R` gives an **immersion**

`Module.freeRankStratumι g f : Module.freeRankStratum g f ⟶ Spec R`

whose factorization property is exactly the flattening stratification for a single rank,
Stacks 05P9: a morphism from an affine scheme factors through it precisely when `f` becomes
invertible and the base change of `M` becomes flat of constant stalk rank `r`.

The basic opens `D(f)` with `f ∈ Module.genBySet R M r` cover the open locus where `M` needs
at most `r` generators (`Module.genByIdeal_notLe_iff_fibreFinrank_le`), and a base change on
which `M` becomes flat of rank `r` automatically lands in that locus
(`Module.map_genByIdeal_eq_top_of_flat_of_rankAtStalk`), so these local strata are the whole
of `S_r`.

Main declarations:

* `Module.freeRankStratum`, `Module.freeRankStratumι` and its `IsImmersion` instance;
* `Module.flat_and_rankAtStalk_iff_exists_freeRankStratumLift` and its `[Algebra R B]` form
  `Module.flat_and_rankAtStalk_iff_exists_freeRankStratumLift'`.
-/

@[expose] public section

noncomputable section

-- These options are load-bearing throughout the library.
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false

open CategoryTheory TensorProduct
open AlgebraicGeometry

universe u v

namespace Module

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M] {r : ℕ}

section Stratum

variable (g : Fin r → M) (f : R)

/-- The presentation of `M` by `g` after inverting `f`. -/
noncomputable abbrev awayPresentation :
    (Fin r → Localization.Away f) →ₗ[Localization.Away f]
      (Localization.Away f) ⊗[R] M :=
  baseChangeMap (Localization.Away f) (familyMap (R := R) g)

/-- **The flattening stratum over `D(f)`.**  The closed subscheme of `D(f) = Spec R_f` cut
out by the relation ideal of the presentation `R_fʳ ↠ M_f`. -/
noncomputable abbrev freeRankStratum : Scheme.{u} :=
  freeRankLocus (awayPresentation g f)

/-- The immersion of the stratum into `Spec R`: a closed immersion into `D(f)` followed by
the open immersion `D(f) ↪ Spec R`. -/
noncomputable def freeRankStratumι :
    freeRankStratum g f ⟶ Spec (CommRingCat.of R) :=
  freeRankLocusι (awayPresentation g f) ≫
    Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))

instance : IsImmersion (freeRankStratumι g f) := by
  unfold freeRankStratumι
  infer_instance

variable {g f}

/-- Transporting flatness and stalk rank across the identification
`B ⊗_{R_f} (R_f ⊗_R M) ≃ B ⊗_R M`. -/
theorem flat_and_rankAtStalk_away_iff (B : Type u) [CommRing B]
    [Algebra R B] [Algebra (Localization.Away f) B]
    [IsScalarTower R (Localization.Away f) B] :
    (Module.Flat B (B ⊗[Localization.Away f] ((Localization.Away f) ⊗[R] M)) ∧
        ∀ q : PrimeSpectrum B,
          Module.rankAtStalk (B ⊗[Localization.Away f]
            ((Localization.Away f) ⊗[R] M)) q = r) ↔
      (Module.Flat B (B ⊗[R] M) ∧
        ∀ q : PrimeSpectrum B, Module.rankAtStalk (B ⊗[R] M) q = r) := by
  set e := TensorProduct.AlgebraTensorModule.cancelBaseChange
    R (Localization.Away f) B B M with he
  constructor
  · rintro ⟨hflat, hrank⟩
    haveI := hflat
    exact ⟨Module.Flat.of_linearEquiv e.symm, fun q ↦ by
      rw [← Module.rankAtStalk_eq_of_equiv e]; exact hrank q⟩
  · rintro ⟨hflat, hrank⟩
    haveI := hflat
    exact ⟨Module.Flat.of_linearEquiv e, fun q ↦ by
      rw [Module.rankAtStalk_eq_of_equiv e]; exact hrank q⟩

/-- **The flattening stratification for one rank, over an affine base.**  A ring map
`φ : R → B` factors `Spec B → Spec R` through the stratum over `D(f)` exactly when `f`
becomes a unit in `B` and the base change of `M` becomes flat of constant stalk rank `r`.

This is Stacks 05P9 for a single rank, in the local form on which the general stratification
is glued: the stratum is a closed subscheme of the open `D(f)`, hence an immersion. -/
theorem flat_and_rankAtStalk_iff_exists_freeRankStratumLift
    (h : ∀ m : M, f • m ∈ Submodule.span R (Set.range g))
    (B : Type u) [CommRing B] (φ : R →+* B) :
    (IsUnit (φ f) ∧
        letI : Algebra R B := φ.toAlgebra
        Module.Flat B (B ⊗[R] M) ∧
          ∀ q : PrimeSpectrum B, Module.rankAtStalk (B ⊗[R] M) q = r) ↔
      ∃ k : Spec (CommRingCat.of B) ⟶ freeRankStratum g f,
        k ≫ freeRankStratumι g f = Spec.map (CommRingCat.ofHom φ) := by
  letI : Algebra R B := φ.toAlgebra
  set A := Localization.Away f with hA
  have hfunit : IsUnit (algebraMap R A f) := IsLocalization.Away.algebraMap_isUnit f
  constructor
  · rintro ⟨hu, hflat, hrank⟩
    letI : Algebra A B := (Localization.awayLift φ f hu).toAlgebra
    have hcomp : (Localization.awayLift φ f hu).comp (algebraMap R A) = φ :=
      IsLocalization.Away.lift_comp f hu
    haveI : IsScalarTower R A B := by
      refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
      exact congrArg (fun ρ : R →+* B ↦ ρ x) hcomp.symm
    have hsurj : Function.Surjective (awayPresentation g f) :=
      surjective_baseChangeMap_of_smul_mem_span h A hfunit
    obtain ⟨k, hk, -⟩ :=
      (flat_and_rankAtStalk_iff_unique_freeRankLocusLift (p := awayPresentation g f)
        hsurj B (Localization.awayLift φ f hu)).mp
        ((flat_and_rankAtStalk_away_iff (f := f) (r := r) B).mpr ⟨hflat, hrank⟩)
    refine ⟨k, ?_⟩
    rw [freeRankStratumι, ← Category.assoc, hk, ← Spec.map_comp]
    congr 1
    exact congrArg CommRingCat.ofHom hcomp
  · rintro ⟨k, hk⟩
    obtain ⟨χ, hχ⟩ := Spec.map_surjective (k ≫ freeRankLocusι (awayPresentation g f))
    have hspec : Spec.map (CommRingCat.ofHom ((χ.hom).comp (algebraMap R A)))
        = Spec.map (CommRingCat.ofHom φ) := by
      have hcat : CommRingCat.ofHom ((χ.hom).comp (algebraMap R A))
          = CommRingCat.ofHom (algebraMap R A) ≫ χ := rfl
      rw [hcat, Spec.map_comp, hχ, Category.assoc]
      exact hk
    have hφ : (χ.hom).comp (algebraMap R A) = φ :=
      congrArg CommRingCat.Hom.hom (Spec.map_injective hspec)
    have hu : IsUnit (φ f) := by
      rw [← hφ]
      exact hfunit.map χ.hom
    refine ⟨hu, ?_⟩
    letI : Algebra A B := χ.hom.toAlgebra
    haveI : IsScalarTower R A B := by
      refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
      exact congrArg (fun ρ : R →+* B ↦ ρ x) hφ.symm
    have hsurj : Function.Surjective (awayPresentation g f) :=
      surjective_baseChangeMap_of_smul_mem_span h A hfunit
    refine (flat_and_rankAtStalk_away_iff (f := f) (r := r) B).mp ?_
    refine (flat_and_rankAtStalk_iff_unique_freeRankLocusLift (p := awayPresentation g f)
      hsurj B χ.hom).mpr ?_
    have hkι : k ≫ freeRankLocusι (awayPresentation g f)
        = Spec.map (CommRingCat.ofHom (CommRingCat.Hom.hom χ)) := by
      rw [← hχ]
      rfl
    refine ⟨k, hkι, fun k' hk' ↦ ?_⟩
    apply (cancel_mono (freeRankLocusι (awayPresentation g f))).mp
    change k' ≫ freeRankLocusι (awayPresentation g f)
      = k ≫ freeRankLocusι (awayPresentation g f)
    rw [hk', hkι]

/-- **The `[Algebra R B]` form** of `flat_and_rankAtStalk_iff_exists_freeRankStratumLift`.

Use this one whenever `B` already carries a canonical `R`-algebra structure — a localization,
say.  Passing the bare ring map instead installs a second, only propositionally equal
`Algebra R B`, and every later `IsScalarTower`/`Module` search picks whichever it finds first. -/
theorem flat_and_rankAtStalk_iff_exists_freeRankStratumLift'
    (h : ∀ m : M, f • m ∈ Submodule.span R (Set.range g))
    (B : Type u) [CommRing B] [Algebra R B] :
    (IsUnit (algebraMap R B f) ∧
        Module.Flat B (B ⊗[R] M) ∧
          ∀ q : PrimeSpectrum B, Module.rankAtStalk (B ⊗[R] M) q = r) ↔
      ∃ k : Spec (CommRingCat.of B) ⟶ freeRankStratum g f,
        k ≫ freeRankStratumι g f = Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
  set φ : R →+* B := algebraMap R B with hφdef
  set A := Localization.Away f with hA
  have hfunit : IsUnit (algebraMap R A f) := IsLocalization.Away.algebraMap_isUnit f
  constructor
  · rintro ⟨hu, hflat, hrank⟩
    letI : Algebra A B := (Localization.awayLift φ f hu).toAlgebra
    have hcomp : (Localization.awayLift φ f hu).comp (algebraMap R A) = φ :=
      IsLocalization.Away.lift_comp f hu
    haveI : IsScalarTower R A B := by
      refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
      exact congrArg (fun ρ : R →+* B ↦ ρ x) hcomp.symm
    have hsurj : Function.Surjective (awayPresentation g f) :=
      surjective_baseChangeMap_of_smul_mem_span h A hfunit
    obtain ⟨k, hk, -⟩ :=
      (flat_and_rankAtStalk_iff_unique_freeRankLocusLift (p := awayPresentation g f)
        hsurj B (Localization.awayLift φ f hu)).mp
        ((flat_and_rankAtStalk_away_iff (f := f) (r := r) B).mpr ⟨hflat, hrank⟩)
    refine ⟨k, ?_⟩
    rw [freeRankStratumι, ← Category.assoc, hk, ← Spec.map_comp]
    congr 1
    exact congrArg CommRingCat.ofHom hcomp
  · rintro ⟨k, hk⟩
    obtain ⟨χ, hχ⟩ := Spec.map_surjective (k ≫ freeRankLocusι (awayPresentation g f))
    have hspec : Spec.map (CommRingCat.ofHom ((χ.hom).comp (algebraMap R A)))
        = Spec.map (CommRingCat.ofHom φ) := by
      have hcat : CommRingCat.ofHom ((χ.hom).comp (algebraMap R A))
          = CommRingCat.ofHom (algebraMap R A) ≫ χ := rfl
      rw [hcat, Spec.map_comp, hχ, Category.assoc]
      exact hk
    have hφ : (χ.hom).comp (algebraMap R A) = φ :=
      congrArg CommRingCat.Hom.hom (Spec.map_injective hspec)
    have hu : IsUnit (φ f) := by
      rw [← hφ]
      exact hfunit.map χ.hom
    refine ⟨hu, ?_⟩
    letI : Algebra A B := χ.hom.toAlgebra
    haveI : IsScalarTower R A B := by
      refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
      exact congrArg (fun ρ : R →+* B ↦ ρ x) hφ.symm
    have hsurj : Function.Surjective (awayPresentation g f) :=
      surjective_baseChangeMap_of_smul_mem_span h A hfunit
    refine (flat_and_rankAtStalk_away_iff (f := f) (r := r) B).mp ?_
    refine (flat_and_rankAtStalk_iff_unique_freeRankLocusLift (p := awayPresentation g f)
      hsurj B χ.hom).mpr ?_
    have hkι : k ≫ freeRankLocusι (awayPresentation g f)
        = Spec.map (CommRingCat.ofHom (CommRingCat.Hom.hom χ)) := by
      rw [← hχ]
      rfl
    refine ⟨k, hkι, fun k' hk' ↦ ?_⟩
    apply (cancel_mono (freeRankLocusι (awayPresentation g f))).mp
    change k' ≫ freeRankLocusι (awayPresentation g f)
      = k ≫ freeRankLocusι (awayPresentation g f)
    rw [hk', hkι]

end Stratum

end Module

end

end
