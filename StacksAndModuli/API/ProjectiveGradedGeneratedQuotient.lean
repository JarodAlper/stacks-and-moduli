module

public import StacksAndModuli.API.ProjectiveGradedFreeOnModule
public import StacksAndModuli.API.ProjectiveTwistGlobalSections
public import Mathlib.LinearAlgebra.DirectSum.Finsupp

/-!
# A graded quotient by relations generated in one degree

Given a map `f : K → M_d₀`, the graded map `S(-d₀) ⊗ K → M` constructed in
`ProjectiveGradedFreeOnModule` presents the quotient of `M` by the graded relations
generated by `f(K)`.  This file packages that quotient and computes its first two pieces.

The degree-`d₀` piece is the ordinary cokernel of `f`.  The degree-`d₀+1` source of
relations is a finite tuple of copies of `K`, indexed by the monomial basis of linear
forms.  This is the coordinate-free graded-module counterpart of the finite
next-degree cokernel in the Hilbert--Grassmannian construction.

Main declarations:

* `GradedModule.generatedQuotient`;
* `GradedModule.generatedQuotientSelfIso`;
* `GradedModule.freeOnModuleSuccLinearEquiv`;
* `GradedModule.freeOnModuleSuccVariablesLinearEquiv`;
* `GradedModule.freeOnModuleSuccRelation`;
* `GradedModule.freeOnModuleVariableRelation`;
* `GradedModule.generatedQuotientSuccIso`.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

universe u

open CategoryTheory CategoryTheory.Limits TensorProduct

namespace AlgebraicGeometry.ProjectiveSpace.GradedModule

variable {R : Type u} [CommRing R] {n : ℕ}

/-- A degree-one exponent vector is uniquely a standard basis vector. -/
noncomputable def degreeOneFinsuppEquiv (n : ℕ) :
    Fin (n + 1) ≃ {m : Fin (n + 1) →₀ ℕ // m.degree = 1} :=
  Equiv.ofBijective (fun i ↦ ⟨Finsupp.single i 1, by simp⟩) ⟨
    fun i j h ↦ Finsupp.single_left_injective one_ne_zero
      (congrArg Subtype.val h),
    fun m ↦ by
      have hm : m.1 ∈ {d : Fin (n + 1) →₀ ℕ | d.degree = 1} := m.2
      rw [← Finsupp.range_single_one] at hm
      obtain ⟨i, hi⟩ := hm
      exact ⟨i, Subtype.ext hi⟩⟩

/-- The chosen finite enumeration of degree-one monomials, reindexed by the corresponding
projective variable. -/
noncomputable def degreeOneMonomialIndexEquiv (n : ℕ) :
    Fin (n + 1) ≃ Fin ((n + 1).choose n) :=
  (degreeOneFinsuppEquiv n).trans (MvPolynomial.degreeMonomialEquivFin n 1)

/-- The degree immediately after the generating degree of `S(-d₀) ⊗ K` is a finite tuple
of copies of `K`, indexed by the chosen degree-one monomial basis. -/
noncomputable def freeOnModuleSuccLinearEquiv (K : ModuleCat.{u} R) (d₀ : ℤ) :
    (freeOnModule (n := n) K d₀).obj (d₀ + 1) ≃ₗ[R]
      Fin ((n + 1).choose n) → K := by
  change (polySubmodule R n (d₀ + 1 + -d₀) ⊗[R] K) ≃ₗ[R]
    Fin ((n + 1).choose n) → K
  exact
    (LinearEquiv.ofEq (polySubmodule R n (d₀ + 1 + -d₀))
      (polySubmodule R n 1) (by congr 1; ring)).rTensor K ≪≫ₗ
    (LinearEquiv.ofEq (polySubmodule R n 1)
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1)
      (polySubmodule_of_nonneg R n (e := 1) (by omega))).rTensor K ≪≫ₗ
    (MvPolynomial.homogeneousSubmoduleFinBasis n R 1).repr.rTensor K ≪≫ₗ
    TensorProduct.finsuppScalarLeft R K (Fin ((n + 1).choose n)) ≪≫ₗ
    Finsupp.linearEquivFunOnFinite R K (Fin ((n + 1).choose n))

/-- The next-degree piece reindexed directly by the `n+1` projective variables. -/
noncomputable def freeOnModuleSuccVariablesLinearEquiv
    (K : ModuleCat.{u} R) (d₀ : ℤ) :
    (freeOnModule (n := n) K d₀).obj (d₀ + 1) ≃ₗ[R] Fin (n + 1) → K :=
  freeOnModuleSuccLinearEquiv (n := n) K d₀ ≪≫ₗ
    (LinearEquiv.piCongrLeft R (fun _ : Fin ((n + 1).choose n) ↦ K)
      (degreeOneMonomialIndexEquiv n)).symm

@[simp]
lemma freeOnModuleSuccVariablesLinearEquiv_apply
    (K : ModuleCat.{u} R) (d₀ : ℤ)
    (z : (freeOnModule (n := n) K d₀).obj (d₀ + 1)) (j : Fin (n + 1)) :
    freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀ z j =
      freeOnModuleSuccLinearEquiv (n := n) K d₀ z
        (degreeOneMonomialIndexEquiv n j) := rfl

/-- Evaluation of the next-degree equivalence on a pure tensor. -/
@[simp]
lemma freeOnModuleSuccLinearEquiv_tmul_apply (K : ModuleCat.{u} R) (d₀ : ℤ)
    (p : polySubmodule R n (d₀ + 1 + -d₀)) (x : K)
    (i : Fin ((n + 1).choose n)) :
    freeOnModuleSuccLinearEquiv (n := n) K d₀ (p ⊗ₜ x) i =
      (MvPolynomial.homogeneousSubmoduleFinBasis n R 1).repr
        ((LinearEquiv.ofEq (polySubmodule R n 1)
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1)
          (polySubmodule_of_nonneg R n (e := 1) (by omega)))
        ((LinearEquiv.ofEq (polySubmodule R n (d₀ + 1 + -d₀))
          (polySubmodule R n 1) (by congr 1; ring)) p)) i • x := by
  change (TensorProduct.finsuppScalarLeft R K (Fin ((n + 1).choose n))
    (((MvPolynomial.homogeneousSubmoduleFinBasis n R 1).repr.rTensor K)
      (((LinearEquiv.ofEq (polySubmodule R n 1)
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1)
        (polySubmodule_of_nonneg R n (e := 1) (by omega))).rTensor K)
      (((LinearEquiv.ofEq (polySubmodule R n (d₀ + 1 + -d₀))
        (polySubmodule R n 1) (by congr 1; ring)).rTensor K) (p ⊗ₜ x))))) i = _
  simp only [LinearEquiv.rTensor_tmul,
    TensorProduct.finsuppScalarLeft_apply_tmul_apply]

/-- The degree-one basis vector, transported back to the integer-indexed polynomial piece
that occurs in `S(-d₀)`. -/
noncomputable def freeOnModuleSuccBasisElement (d₀ : ℤ)
    (i : Fin ((n + 1).choose n)) : polySubmodule R n (d₀ + 1 + -d₀) :=
  (LinearEquiv.ofEq (polySubmodule R n (d₀ + 1 + -d₀))
    (polySubmodule R n 1) (by congr 1; ring)).symm
      ((LinearEquiv.ofEq (polySubmodule R n 1)
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1)
        (polySubmodule_of_nonneg R n (e := 1) (by omega))).symm
          (MvPolynomial.homogeneousSubmoduleFinBasis n R 1 i))

lemma freeOnModuleSuccBasisElement_toHomogeneous (d₀ : ℤ)
    (i : Fin ((n + 1).choose n)) :
    (LinearEquiv.ofEq (polySubmodule R n 1)
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1)
      (polySubmodule_of_nonneg R n (e := 1) (by omega)))
        ((LinearEquiv.ofEq (polySubmodule R n (d₀ + 1 + -d₀))
          (polySubmodule R n 1) (by congr 1; ring))
            (freeOnModuleSuccBasisElement (R := R) (n := n) d₀ i)) =
      MvPolynomial.homogeneousSubmoduleFinBasis n R 1 i := by
  rfl

/-- A coordinate vector supported at one monomial corresponds to the associated basis form
tensored with its coefficient. -/
@[simp]
lemma freeOnModuleSuccLinearEquiv_symm_single (K : ModuleCat.{u} R) (d₀ : ℤ)
    (i : Fin ((n + 1).choose n)) (x : K) :
    (freeOnModuleSuccLinearEquiv (n := n) K d₀).symm (Pi.single i x) =
      freeOnModuleSuccBasisElement (R := R) (n := n) d₀ i ⊗ₜ x := by
  apply (freeOnModuleSuccLinearEquiv (n := n) K d₀).injective
  ext j
  rw [LinearEquiv.apply_symm_apply]
  rw [freeOnModuleSuccLinearEquiv_tmul_apply]
  rw [freeOnModuleSuccBasisElement_toHomogeneous,
    (MvPolynomial.homogeneousSubmoduleFinBasis n R 1).repr_self]
  simp [Pi.single_apply, Finsupp.single_apply, eq_comm]

/-- In variable coordinates, a vector supported at `j` is the basis form `X_j` tensored
with its coefficient. -/
@[simp]
lemma freeOnModuleSuccVariablesLinearEquiv_symm_single
    (K : ModuleCat.{u} R) (d₀ : ℤ) (j : Fin (n + 1)) (x : K) :
    (freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀).symm (Pi.single j x) =
      freeOnModuleSuccBasisElement (R := R) (n := n) d₀
        (degreeOneMonomialIndexEquiv n j) ⊗ₜ x := by
  apply (freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀).injective
  ext k
  rw [LinearEquiv.apply_symm_apply]
  rw [freeOnModuleSuccVariablesLinearEquiv_apply,
    freeOnModuleSuccLinearEquiv_tmul_apply,
    freeOnModuleSuccBasisElement_toHomogeneous,
    (MvPolynomial.homogeneousSubmoduleFinBasis n R 1).repr_self]
  by_cases h : k = j
  · simp [h]
  · simp [h, (degreeOneMonomialIndexEquiv n).injective.eq_iff]

/-- The graded quotient of `M` by the relations generated by the image of
`f : K → M_d₀`. -/
noncomputable def generatedQuotient (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) : GradedModule R n :=
  coker (freeOnModuleHom M d₀ K f)

lemma range_freeOnModuleHom_app_self (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    LinearMap.range ((freeOnModuleHom M d₀ K f).app d₀).hom =
      LinearMap.range f.hom := by
  rw [freeOnModuleHom_app_self]
  ext y
  constructor
  · rintro ⟨z, rfl⟩
    exact ⟨freeOnModuleSelfLinearEquiv (n := n) K d₀ z, rfl⟩
  · rintro ⟨x, rfl⟩
    exact ⟨(freeOnModuleSelfLinearEquiv (n := n) K d₀).symm x, by simp⟩

/-- The generating-degree piece of the graded quotient is the ordinary cokernel of `f`. -/
noncomputable def generatedQuotientSelfIso (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    (generatedQuotient M d₀ K f).obj d₀ ≅ cokernel f :=
  (Submodule.quotEquivOfEq _ _
      (range_freeOnModuleHom_app_self M d₀ K f)).toModuleIso ≪≫
    (ModuleCat.cokernelIsoRangeQuotient f).symm

/-- The finite relation map on the degree immediately after the generating degree, written
in monomial coordinates. -/
noncomputable def freeOnModuleSuccRelation (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    ModuleCat.of R (Fin ((n + 1).choose n) → K) ⟶ M.obj (d₀ + 1) :=
  ModuleCat.ofHom (((freeOnModuleHom M d₀ K f).app (d₀ + 1)).hom.comp
    (freeOnModuleSuccLinearEquiv (n := n) K d₀).symm.toLinearMap)

/-- The same next-degree relation map, with its source indexed directly by projective
variables rather than by the enumerated monomial basis. -/
noncomputable def freeOnModuleVariableRelation (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    ModuleCat.of R (Fin (n + 1) → K) ⟶ M.obj (d₀ + 1) :=
  ModuleCat.ofHom (((freeOnModuleHom M d₀ K f).app (d₀ + 1)).hom.comp
    (freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀).symm.toLinearMap)

/-- On a vector supported at `j`, the variable-indexed relation is multiplication by the
degree-one basis form corresponding to `X_j`. -/
@[simp]
lemma freeOnModuleVariableRelation_single (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀)
    (j : Fin (n + 1)) (x : K) :
    (freeOnModuleVariableRelation M d₀ K f).hom (Pi.single j x) =
      mulFormZ M (d₀ + 1 + -d₀) d₀ (d₀ + 1) (by ring)
        (freeOnModuleSuccBasisElement (R := R) (n := n) d₀
          (degreeOneMonomialIndexEquiv n j)) (f.hom x) := by
  change ((freeOnModuleHom M d₀ K f).app (d₀ + 1)).hom
      ((freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀).symm
        (Pi.single j x)) = _
  rw [freeOnModuleSuccVariablesLinearEquiv_symm_single]
  rfl

/-- On a coordinate vector, the next-degree relation is multiplication of `f(x)` by the
associated degree-one basis form. -/
@[simp]
lemma freeOnModuleSuccRelation_single (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀)
    (i : Fin ((n + 1).choose n)) (x : K) :
    (freeOnModuleSuccRelation M d₀ K f).hom (Pi.single i x) =
      mulFormZ M (d₀ + 1 + -d₀) d₀ (d₀ + 1) (by ring)
        (freeOnModuleSuccBasisElement (R := R) (n := n) d₀ i) (f.hom x) := by
  change ((freeOnModuleHom M d₀ K f).app (d₀ + 1)).hom
      ((freeOnModuleSuccLinearEquiv (n := n) K d₀).symm (Pi.single i x)) = _
  rw [freeOnModuleSuccLinearEquiv_symm_single]
  rfl

lemma range_freeOnModuleHom_app_succ (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    LinearMap.range ((freeOnModuleHom M d₀ K f).app (d₀ + 1)).hom =
      LinearMap.range (freeOnModuleSuccRelation M d₀ K f).hom := by
  ext y
  constructor
  · rintro ⟨z, rfl⟩
    exact ⟨freeOnModuleSuccLinearEquiv (n := n) K d₀ z,
      by simp [freeOnModuleSuccRelation]⟩
  · rintro ⟨x, rfl⟩
    exact ⟨(freeOnModuleSuccLinearEquiv (n := n) K d₀).symm x, rfl⟩

/-- The next-degree piece of the graded quotient is the cokernel of the finite relation map
on the monomial-coordinate tuple of copies of `K`. -/
noncomputable def generatedQuotientSuccIso (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    (generatedQuotient M d₀ K f).obj (d₀ + 1) ≅
      cokernel (freeOnModuleSuccRelation M d₀ K f) :=
  (Submodule.quotEquivOfEq _ _
      (range_freeOnModuleHom_app_succ M d₀ K f)).toModuleIso ≪≫
    (ModuleCat.cokernelIsoRangeQuotient
      (freeOnModuleSuccRelation M d₀ K f)).symm

lemma range_freeOnModuleHom_app_variableSucc (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    LinearMap.range ((freeOnModuleHom M d₀ K f).app (d₀ + 1)).hom =
      LinearMap.range (freeOnModuleVariableRelation M d₀ K f).hom := by
  ext y
  constructor
  · rintro ⟨z, rfl⟩
    exact ⟨freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀ z,
      by simp [freeOnModuleVariableRelation]⟩
  · rintro ⟨x, rfl⟩
    exact ⟨(freeOnModuleSuccVariablesLinearEquiv (n := n) K d₀).symm x, rfl⟩

/-- The next-degree piece of the generated quotient, now as the cokernel of the
variable-indexed relation map. -/
noncomputable def generatedQuotientVariableSuccIso (M : GradedModule R n) (d₀ : ℤ)
    (K : ModuleCat.{u} R) (f : K ⟶ M.obj d₀) :
    (generatedQuotient M d₀ K f).obj (d₀ + 1) ≅
      cokernel (freeOnModuleVariableRelation M d₀ K f) :=
  (Submodule.quotEquivOfEq _ _
      (range_freeOnModuleHom_app_variableSucc M d₀ K f)).toModuleIso ≪≫
    (ModuleCat.cokernelIsoRangeQuotient
      (freeOnModuleVariableRelation M d₀ K f)).symm

end AlgebraicGeometry.ProjectiveSpace.GradedModule

end

end
