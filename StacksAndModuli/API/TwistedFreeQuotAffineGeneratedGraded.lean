module

public import StacksAndModuli.API.ProjectiveGradedGeneratedQuotient
public import StacksAndModuli.API.TwistedFreeQuotReconstructedGeneratedNextDegree

/-!
# The affine generated graded quotient attached to a twisted-free quotient

Over an affine base `Spec R`, a quotient of the degree-`e` monomial presentation
determines a graded quotient of a twisted polynomial module by the homogeneous
relations generated by the affine sections of its kernel. This file identifies
the generating-degree piece with the given quotient and the successor piece with
the finite next-degree cokernel.

The successor comparison is proved directly in monomial coordinates. In
particular, it does not use cohomology and base change for a geometric
pushforward.

Main declarations:

* `AlgebraicGeometry.affineReconstructedGeneratedGradedQuotient`;
* `AlgebraicGeometry.affineReconstructedGeneratedGradedQuotientSelfIso`;
* `AlgebraicGeometry.affineTwistedFreeNextDegreeRelation_square`;
* `AlgebraicGeometry.affineReconstructedGeneratedGradedQuotientSuccIso`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe u

namespace AlgebraicGeometry

noncomputable section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false

/-- Affine sections of the kernel, included into the finite monomial-coordinate module. -/
noncomputable def affineReconstructedKernelInclusion
    (n : ℕ) (R : CommRingCat.{u}) (r e : ℕ)
    {E : (Spec R).Modules}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ⟶ E) :
    moduleSpecΓFunctor.obj (kernel u) ⟶
      ModuleCat.of R
        ((ULift.{u} (Fin r) × Fin ((n + e).choose n)) → R) :=
  moduleSpecΓFunctor.map (kernel.ι u) ≫
    (freeModuleSpecΓIso (R := R)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n))).inv ≫
    (Finsupp.linearEquivFunOnFinite R R
      (ULift.{u} (Fin r) × Fin ((n + e).choose n))).toModuleIso.hom

open ProjectiveSpace

/-- Monomial coordinates on a homogeneous piece of a finite power of a twisted
polynomial graded module. -/
noncomputable def twistedFreeGradedMonomialEquiv
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) :
    (((GradedModule.structureModule R n).twist (-l)).pow r).obj (d : ℤ) ≃ₗ[R]
      ((ULift.{u} (Fin r) × Fin ((n + e).choose n)) → R) :=
  GradedModule.freeObjHomogeneousEquiv R n l r (d : ℤ) e he.symm ≪≫ₗ
    (LinearEquiv.piCongrRight fun _ : Fin r =>
      (MvPolynomial.homogeneousSubmoduleFinBasis n R e).repr) ≪≫ₗ
    (LinearEquiv.piCongrRight fun _ : Fin r =>
      Finsupp.linearEquivFunOnFinite R R (Fin ((n + e).choose n))) ≪≫ₗ
    (LinearEquiv.curry R R (Fin r) (Fin ((n + e).choose n))).symm ≪≫ₗ
    LinearEquiv.funCongrLeft R R
      ((Equiv.ulift.{u, 0} (α := Fin r)).prodCongr (Equiv.refl _))

/-- Affine sections of a finite free sheaf, expressed as coordinate functions. -/
noncomputable def affineFreeCoordinateIso
    (R : CommRingCat.{u}) (I : Type u) [Finite I] :
    moduleSpecΓFunctor.obj
        (SheafOfModules.free (R := (Spec R).ringCatSheaf) I) ≅
      ModuleCat.of R (I → R) :=
  (freeModuleSpecΓIso (R := R) I).symm ≪≫
    (Finsupp.linearEquivFunOnFinite R R I).toModuleIso

/-- Push a finitely supported coordinate function forward along a map of finite
indexing types, summing coordinates in each fiber. -/
noncomputable def finitePiMapDomain
    (R : Type u) [CommRing R] {I J : Type u} [Finite I] [Finite J]
    (φ : I → J) : (I → R) →ₗ[R] (J → R) :=
  (Finsupp.linearEquivFunOnFinite R R J).toLinearMap.comp
    ((Finsupp.lmapDomain R R φ).comp
      (Finsupp.linearEquivFunOnFinite R R I).symm.toLinearMap)

/-- A single coordinate is sent to the corresponding single coordinate by
`finitePiMapDomain`. -/
@[simp]
lemma finitePiMapDomain_single
    (R : Type u) [CommRing R] {I J : Type u} [Finite I] [Finite J]
    [DecidableEq I] [DecidableEq J]
    (phi : I → J) (i : I) (c : R) :
    finitePiMapDomain R phi (Pi.single i c) = Pi.single (phi i) c := by
  classical
  apply (Finsupp.linearEquivFunOnFinite R R J).symm.injective
  simp [finitePiMapDomain]

/-- Naturality of affine sections of a free sheaf with respect to a map of its
free generators. -/
lemma freeModuleSpecΓIso_hom_comp_map_freeMap
    (R : CommRingCat.{u}) {I J : Type u} (φ : I → J) :
    (freeModuleSpecΓIso (R := R) I).hom ≫
        moduleSpecΓFunctor.map
          (SheafOfModules.freeMap (R := (Spec R).ringCatSheaf) φ) =
      ModuleCat.ofHom (Finsupp.lmapDomain R R φ) ≫
        (freeModuleSpecΓIso (R := R) J).hom := by
  apply ModuleCat.hom_ext
  refine Finsupp.lhom_ext' fun i ↦ ?_
  apply LinearMap.ext_ring
  let G := moduleSpecΓFunctor (R := R)
  let m := SheafOfModules.freeMap
    (R := (Spec R).ringCatSheaf) φ
  have hleft :
      ModuleCat.ofHom (Finsupp.lsingle i (R := R)
          (M := ModuleCat.of R R)) ≫
          (freeModuleSpecΓIso (R := R) I).hom ≫ G.map m =
        (unitModuleSpecΓIso R).hom ≫
          G.map (SheafOfModules.ιFree
            (R := (Spec R).ringCatSheaf) (φ i)) := by
    let a := ModuleCat.ofHom (Finsupp.lsingle i (R := R)
      (M := ModuleCat.of R R))
    let b := (freeModuleSpecΓIso (R := R) I).hom
    let c := (unitModuleSpecΓIso R).hom
    let ιi := SheafOfModules.ιFree
      (R := (Spec R).ringCatSheaf) i
    let ιφ := SheafOfModules.ιFree
      (R := (Spec R).ringCatSheaf) (φ i)
    have hab : a ≫ b = c ≫ G.map ιi :=
      lsingle_comp_freeModuleSpecΓIso_hom (R := R) I i
    have hι : ιi ≫ m = ιφ := SheafOfModules.ιFree_freeMap φ i
    calc
      a ≫ b ≫ G.map m = (a ≫ b) ≫ G.map m :=
        (Category.assoc _ _ _).symm
      _ = (c ≫ G.map ιi) ≫ G.map m :=
        congrArg (fun q ↦ q ≫ G.map m) hab
      _ = c ≫ (G.map ιi ≫ G.map m) := Category.assoc _ _ _
      _ = c ≫ G.map (ιi ≫ m) :=
        congrArg (fun q ↦ c ≫ q) (G.map_comp ιi m).symm
      _ = c ≫ G.map ιφ := congrArg (fun q ↦ c ≫ G.map q) hι
  have hright := lsingle_comp_freeModuleSpecΓIso_hom
    (R := R) J (φ i)
  have hleftApp := congrArg
    (fun f : ModuleCat.of R R ⟶ G.obj
        (SheafOfModules.free (R := (Spec R).ringCatSheaf) J) ↦ f.hom 1)
    hleft
  have hrightApp := congrArg
    (fun f : ModuleCat.of R R ⟶ G.obj
        (SheafOfModules.free (R := (Spec R).ringCatSheaf) J) ↦ f.hom 1)
    hright
  exact hleftApp.trans (hrightApp.symm.trans (by
    simp [G, Finsupp.lmapDomain_apply]))

/-- In finite function coordinates, affine sections of `freeMap φ` are the
coordinate pushforward along `φ`. -/
lemma affineFreeCoordinateIso_map_freeMap
    (R : CommRingCat.{u}) {I J : Type u} [Finite I] [Finite J]
    (φ : I → J) :
    moduleSpecΓFunctor.map
        (SheafOfModules.freeMap (R := (Spec R).ringCatSheaf) φ) ≫
        (affineFreeCoordinateIso R J).hom =
      (affineFreeCoordinateIso R I).hom ≫
        ModuleCat.ofHom (finitePiMapDomain R φ) := by
  let a := (freeModuleSpecΓIso (R := R) I).hom
  let a' := (freeModuleSpecΓIso (R := R) I).inv
  let b := (freeModuleSpecΓIso (R := R) J).hom
  let b' := (freeModuleSpecΓIso (R := R) J).inv
  let g := moduleSpecΓFunctor.map
    (SheafOfModules.freeMap (R := (Spec R).ringCatSheaf) φ)
  let L := ModuleCat.ofHom (Finsupp.lmapDomain R R φ)
  let pI := (Finsupp.linearEquivFunOnFinite R R I).toModuleIso.hom
  let pJ := (Finsupp.linearEquivFunOnFinite R R J).toModuleIso.hom
  let q := ModuleCat.ofHom (finitePiMapDomain R φ)
  change g ≫ b' ≫ pJ = a' ≫ pI ≫ q
  apply (cancel_epi a).1
  have hab : a ≫ g = L ≫ b :=
    freeModuleSpecΓIso_hom_comp_map_freeMap R φ
  calc
    a ≫ (g ≫ b' ≫ pJ) = (a ≫ g) ≫ b' ≫ pJ := by
      simp only [Category.assoc]
    _ = (L ≫ b) ≫ b' ≫ pJ := by rw [hab]
    _ = L ≫ pJ := by
      dsimp only [b, b']
      simp
    _ = pI ≫ q := by
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      simp [L, pI, pJ, q, finitePiMapDomain]
    _ = a ≫ (a' ≫ pI ≫ q) := by
      dsimp only [a, a']
      simp

/-- Affine sections of the degree-`d` free monomial sheaf identified with the
degree-`d` piece of the corresponding twisted polynomial module. -/
noncomputable def affineTwistedFreeDegreeIso
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) :
    moduleSpecΓFunctor.obj
        (SheafOfModules.free (R := (Spec R).ringCatSheaf)
          (ULift.{u} (Fin r) × Fin ((n + e).choose n))) ≅
      (((GradedModule.structureModule R n).twist (-l)).pow r).obj (d : ℤ) :=
  affineFreeCoordinateIso R
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ≪≫
  (twistedFreeGradedMonomialEquiv n R l r d e he).toModuleIso.symm

/-- The affine kernel relation in degree `d`, transported from monomial sheaf
coordinates to the twisted polynomial graded module. -/
noncomputable def affineReconstructedKernelRelation
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) {E : (Spec R).Modules}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ⟶ E) :
    (Scheme.Modules.specEvaluation R ⊤).obj (kernel u) ⟶
      (((GradedModule.structureModule R n).twist (-l)).pow r).obj (d : ℤ) :=
  (Scheme.Modules.specEvaluation R ⊤).map (kernel.ι u) ≫
    (affineTwistedFreeDegreeIso n R l r d e he).hom

/-- The quotient of the twisted polynomial graded module by the homogeneous
relations generated by the affine sections of `kernel u` in degree `d`. -/
noncomputable def affineReconstructedGeneratedGradedQuotient
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) {E : (Spec R).Modules}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ⟶ E) :
    ProjectiveSpace.GradedModule R n :=
  ProjectiveSpace.GradedModule.generatedQuotient
    (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r)
    (d : ℤ) ((Scheme.Modules.specEvaluation R ⊤).obj (kernel u))
    (affineReconstructedKernelRelation n R l r d e he u)

/-- For an epimorphic quotient over an affine base, the generating-degree piece
of `affineReconstructedGeneratedGradedQuotient` is the affine module of the
given quotient. -/
noncomputable def affineReconstructedGeneratedGradedQuotientSelfIso
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) {E : (Spec R).Modules}
    [E.IsQuasicoherent]
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ⟶ E) [Epi u] :
    (affineReconstructedGeneratedGradedQuotient n R l r d e he u).obj (d : ℤ) ≅
      (Scheme.Modules.specEvaluation R ⊤).obj E := by
  letI : (Scheme.Modules.specEvaluation R ⊤).PreservesZeroMorphisms :=
    { map_zero := by
        intros
        rfl }
  letI : Epi ((Scheme.Modules.specEvaluation R ⊤).map u) :=
    (ModuleCat.epi_iff_surjective _).mpr
      (Scheme.Modules.moduleSpecΓFunctor_map_surjective_of_epi u)
  exact ProjectiveSpace.GradedModule.generatedQuotientSelfIso
      (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r)
      (d : ℤ) ((Scheme.Modules.specEvaluation R ⊤).obj (kernel u))
      (affineReconstructedKernelRelation n R l r d e he u) ≪≫
    cokernelCompIsIso
      ((Scheme.Modules.specEvaluation R ⊤).map (kernel.ι u))
      (affineTwistedFreeDegreeIso n R l r d e he).hom ≪≫
    cokernel.mapIso
      ((Scheme.Modules.specEvaluation R ⊤).map (kernel.ι u))
      (kernel.ι ((Scheme.Modules.specEvaluation R ⊤).map u))
      (PreservesKernel.iso (Scheme.Modules.specEvaluation R ⊤) u) (Iso.refl _)
      (by
        change (Scheme.Modules.specEvaluation R ⊤).map (kernel.ι u) = _
        rw [PreservesKernel.iso_hom]
        exact (kernelComparison_comp_ι u
          (Scheme.Modules.specEvaluation R ⊤)).symm) ≪≫
    cokernelKernelIsoOfEpi ((Scheme.Modules.specEvaluation R ⊤).map u)

/-- Affine sections identify the finite coproduct of copies of `kernel u`, indexed
by projective variables, with a tuple of affine kernel sections. -/
noncomputable def affineKernelVariableCoproductIso
    (n : ℕ) (R : CommRingCat.{u}) {E : (Spec R).Modules}
    {I : Type u}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf) I ⟶ E) :
    (Scheme.Modules.specEvaluation R ⊤).obj
        (∐ fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u) ≅
      ModuleCat.of R
        (Fin (n + 1) → (Scheme.Modules.specEvaluation R ⊤).obj (kernel u)) :=
  PreservesCoproduct.iso (Scheme.Modules.specEvaluation R ⊤)
      (fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u) ≪≫
    (biproduct.isoCoproduct
      (fun _ : ULift.{u} (Fin (n + 1)) ↦
        (Scheme.Modules.specEvaluation R ⊤).obj (kernel u))).symm ≪≫
    Scheme.Modules.moduleCatFiniteBiproductIsoPi
      (fun _ : ULift.{u} (Fin (n + 1)) ↦
        (Scheme.Modules.specEvaluation R ⊤).obj (kernel u)) ≪≫
    (LinearEquiv.funCongrLeft R
      ((Scheme.Modules.specEvaluation R ⊤).obj (kernel u))
      (Equiv.ulift.{u, 0} (α := Fin (n + 1)))).toModuleIso.symm

/-- Under `affineKernelVariableCoproductIso`, a coproduct injection becomes the
corresponding single-coordinate function. -/
lemma affineKernelVariableCoproductIso_hom_map_ι
    (n : ℕ) (R : CommRingCat.{u}) {E : (Spec R).Modules}
    {I : Type u}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf) I ⟶ E)
    (j : ULift.{u} (Fin (n + 1)))
    (x : (Scheme.Modules.specEvaluation R ⊤).obj (kernel u)) :
    (affineKernelVariableCoproductIso n R u).hom.hom
        (((Scheme.Modules.specEvaluation R ⊤).map
          (Sigma.ι (fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u) j)).hom x) =
      Pi.single j.down x := by
  classical
  let G := Scheme.Modules.specEvaluation R ⊤
  let F : ULift.{u} (Fin (n + 1)) → (Spec R).Modules :=
    fun _ ↦ kernel u
  let H : ULift.{u} (Fin (n + 1)) → ModuleCat.{u} R :=
    fun _ ↦ G.obj (kernel u)
  have hpres : G.map (Sigma.ι F j) ≫
      (PreservesCoproduct.iso G F).hom = Sigma.ι H j := by
    calc
      _ = G.map (Sigma.ι F j) ≫
          inv (PreservesCoproduct.iso G F).inv :=
        congrArg (fun q ↦ G.map (Sigma.ι F j) ≫ q)
          (IsIso.Iso.inv_inv (PreservesCoproduct.iso G F)).symm
      _ = G.map (Sigma.ι F j) ≫ inv (sigmaComparison G F) := rfl
      _ = _ := map_ι_comp_inv_sigmaComparison G F j
  have hcop : Sigma.ι H j ≫ (biproduct.isoCoproduct H).inv =
      biproduct.ι H j := by
    rw [biproduct.isoCoproduct_inv]
    exact Sigma.ι_desc (biproduct.ι H) j
  have hpre : G.map (Sigma.ι F j) ≫
      (PreservesCoproduct.iso G F).hom ≫
        (biproduct.isoCoproduct H).inv = biproduct.ι H j := by
    rw [← Category.assoc, hpres, hcop]
  funext k
  have hA : ∀ (w : (⨁ H : ModuleCat.{u} R)) (i : ULift.{u} (Fin (n + 1))),
      ((Scheme.Modules.moduleCatFiniteBiproductIsoPi H).hom.hom w) i =
        (biproduct.π H i).hom w := by
    intro w i
    exact congrArg (fun f : (⨁ H : ModuleCat.{u} R) ⟶ H i ↦ f.hom w)
      (IsLimit.conePointUniqueUpToIso_hom_comp (biproduct.isLimit H)
        (ModuleCat.HasLimit.productLimitCone H).isLimit ⟨i⟩)
  simp only [affineKernelVariableCoproductIso, Iso.trans_hom, Iso.symm_hom,
    biproduct.isoCoproduct_inv, LinearEquiv.toModuleIso_inv,
    LinearEquiv.funCongrLeft_symm, ModuleCat.hom_comp,
    ConcreteCategory.hom_ofHom, LinearMap.coe_comp, LinearEquiv.coe_coe,
    Function.comp_apply, LinearEquiv.funCongrLeft_apply,
    Equiv.ulift_symm_apply, LinearMap.funLeft_apply, Pi.single_apply]
  rw [hA]
  have hpreApp := congrArg
    (fun f : G.obj (F j) ⟶ (⨁ H : ModuleCat.{u} R) ↦ f.hom x) hpre
  change (biproduct.π H (ULift.up k)).hom
      ((G.map (Sigma.ι F j) ≫ (PreservesCoproduct.iso G F).hom ≫
        (biproduct.isoCoproduct H).inv).hom x) = _
  rw [hpreApp]
  change ((biproduct.ι H j ≫ biproduct.π H (ULift.up k)).hom x) = _
  by_cases hkj : k = j.down
  · have hju : j = ULift.up k := by
      apply ULift.ext
      exact hkj.symm
    rw [ite_eq_left hkj]
    subst j
    rw [biproduct.ι_π_self]
    rfl
  · have hju : j ≠ ULift.up k := fun h ↦
      hkj (congrArg ULift.down h).symm
    rw [ite_eq_right hkj, biproduct.ι_π_ne H hju]
    rfl

open ProjectiveSpace.GradedModule

/-- The successor-degree basis element indexed by a projective variable has
underlying polynomial equal to that variable. -/
lemma freeOnModuleSuccBasisElement_variable_val
    (n : ℕ) (R : Type u) [CommRing R] (d₀ : ℤ) (j : Fin (n + 1)) :
    (freeOnModuleSuccBasisElement (R := R) (n := n) d₀
      (degreeOneMonomialIndexEquiv n j)).1 = MvPolynomial.X j := by
  change ((MvPolynomial.homogeneousSubmoduleFinBasis n R 1
    (degreeOneMonomialIndexEquiv n j) :
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1) :
        MvPolynomial (Fin (n + 1)) R) = MvPolynomial.X j
  rw [show degreeOneMonomialIndexEquiv n j =
      ProjectiveSpace.degreeOneMonomialIndex n j from rfl]
  rw [ProjectiveSpace.homogeneousSubmoduleFinBasis_degreeOneMonomialIndex]
  rfl

/-- Multiplication by the successor-degree basis element indexed by `j` agrees
with the graded-module action of the variable `X_j`. -/
lemma mulFormZ_freeOnModuleSuccBasisElement_variable
    {R : Type u} [CommRing R] {n : ℕ}
    (M : ProjectiveSpace.GradedModule R n) (d₀ : ℤ)
    (j : Fin (n + 1)) (x : M.obj d₀) :
    mulFormZ M (d₀ + 1 + -d₀) d₀ (d₀ + 1) (by ring)
        (freeOnModuleSuccBasisElement (R := R) (n := n) d₀
          (degreeOneMonomialIndexEquiv n j)) x =
      (M.mulX j d₀).hom x := by
  let b : Fin (n + 1) →₀ ℕ := Finsupp.single j 1
  let p := freeOnModuleSuccBasisElement (R := R) (n := n) d₀
    (degreeOneMonomialIndexEquiv n j)
  have hp : p.1 = MvPolynomial.monomial b 1 := by
    rw [freeOnModuleSuccBasisElement_variable_val]
    dsimp only [b]
    rw [← MvPolynomial.X_pow_eq_monomial]
    simp
  let q : polySubmodule R n (d₀ + 1 + -d₀) :=
    ⟨MvPolynomial.monomial b 1, hp ▸ p.2⟩
  have hpq : p = q := Subtype.ext hp
  change mulFormZ M (d₀ + 1 + -d₀) d₀ (d₀ + 1) _ p x = _
  rw [hpq]
  rw [mulFormZ_monomial M (d₀ + 1 + -d₀) d₀ (d₀ + 1)
    (by ring) b (by simp [b]) 1 q.2 x]
  simp only [one_smul]
  rw [ProjectiveSpace.GradedModule.mulMono_single]
  exact congrArg (fun f ↦ f.hom x)
    (ProjectiveSpace.GradedModule.mulX'_rfl M j d₀)

/-- The inverse monomial-coordinate equivalence sends a coordinate vector to the
matching homogeneous basis vector in the matching free summand. -/
lemma twistedFreeGradedMonomialEquiv_symm_single_one
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ))
    (a : ULift.{u} (Fin r)) (i : Fin ((n + e).choose n)) :
    (twistedFreeGradedMonomialEquiv n R l r d e he).symm
        (Pi.single (a, i) 1) =
      (ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
        R n l r (d : ℤ) e he.symm).symm
        (Pi.single a.down
          (MvPolynomial.homogeneousSubmoduleFinBasis n R e i)) := by
  let E := twistedFreeGradedMonomialEquiv n R l r d e he
  apply E.injective
  rw [E.apply_symm_apply]
  funext x
  simp [E, twistedFreeGradedMonomialEquiv, Pi.single_apply]
  rcases x with ⟨a', i'⟩
  by_cases ha : a' = a
  · subst a'
    by_cases hi : i' = i
    · subst i'
      simp
    · simp [hi]
  · have hdown : a'.down ≠ a.down := by
      intro h
      apply ha
      apply ULift.ext
      exact h
    simp [ha, hdown]

/-- The free-object homogeneous equivalence preserves the underlying polynomial
in each coordinate. -/
@[simp]
lemma freeObjHomogeneousEquiv_apply_val
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r : ℕ)
    (d : ℤ) (e : ℕ) (he : (e : ℤ) = d - l)
    (x : ((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).obj d))
    (t : Fin r) :
    (((ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
      R n l r d e he) x t :
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R e) :
          MvPolynomial (Fin (n + 1)) R) = (x t).1 := by
  rfl

/-- The inverse free-object homogeneous equivalence preserves the underlying
polynomial in each coordinate. -/
@[simp]
lemma freeObjHomogeneousEquiv_symm_apply_val
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r : ℕ)
    (d : ℤ) (e : ℕ) (he : (e : ℤ) = d - l)
    (x : Fin r → MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R e)
    (t : Fin r) :
    ((((ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
      R n l r d e he).symm x) t).1 :
        MvPolynomial (Fin (n + 1)) R) = (x t).1 := by
  rfl

/-- Multiplication by `X_j` sends a single homogeneous monomial basis vector to
the successor monomial selected by `twistedFreeNextMonomialIndex`. -/
lemma freeObjHomogeneousEquiv_mulX_symm_single_basis
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ))
    (j : Fin (n + 1)) (a : Fin r) (i : Fin ((n + e).choose n)) :
    (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
        j (d : ℤ)).hom)
        ((ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
          R n l r (d : ℤ) e he.symm).symm
          (Pi.single a
            (MvPolynomial.homogeneousSubmoduleFinBasis n R e i))) =
      (ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
        R n l r ((d + 1 : ℕ) : ℤ) (e + 1) (by omega)).symm
        (Pi.single a
          (MvPolynomial.homogeneousSubmoduleFinBasis n R (e + 1)
            (Scheme.twistedFreeNextMonomialIndex n e j i))) := by
  let En := ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
    R n l r ((d + 1 : ℕ) : ℤ) (e + 1) (by omega)
  apply En.injective
  rw [En.apply_symm_apply]
  funext t
  apply Subtype.ext
  rw [freeObjHomogeneousEquiv_apply_val]
  rw [ProjectiveSpace.GradedModule.pow_mulX_apply]
  let p := ((ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
    R n l r (d : ℤ) e he.symm).symm
      (Pi.single a
        (MvPolynomial.homogeneousSubmoduleFinBasis n R e i))) t
  have htwist :
      (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).mulX
        j (d : ℤ)).hom p).1 : MvPolynomial (Fin (n + 1)) R) =
          MvPolynomial.X j * p.1 := by
    exact ProjectiveSpace.GradedModule.structureModule_mulX'_val
      j ((d : ℤ) + -l) ((d : ℤ) + 1 + -l) (by ring) p
  change (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).mulX
    j (d : ℤ)).hom p).1 : MvPolynomial (Fin (n + 1)) R) = _
  rw [htwist]
  change MvPolynomial.X j *
      (((ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
        R n l r (d : ℤ) e he.symm).symm
        (Pi.single a
          (MvPolynomial.homogeneousSubmoduleFinBasis n R e i))) t).1 = _
  rw [freeObjHomogeneousEquiv_symm_apply_val]
  by_cases ht : t = a
  · subst t
    simp only [Pi.single_eq_same]
    rw [mul_comm]
    rw [show MvPolynomial.X j =
        ((MvPolynomial.homogeneousSubmoduleFinBasis n R 1
          (Scheme.twistedFreeDegreeOneMonomialIndex n j) :
            MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1) :
              MvPolynomial (Fin (n + 1)) R) by
      rw [show Scheme.twistedFreeDegreeOneMonomialIndex n j =
          ProjectiveSpace.degreeOneMonomialIndex n j from rfl]
      rw [ProjectiveSpace.homogeneousSubmoduleFinBasis_degreeOneMonomialIndex]
      rfl]
    exact Scheme.twistedFreeMonomialBasis_mul_degreeOne n R e j i
  · simp [ht]

/-- The monomial-coordinate equivalences intertwine multiplication by `X_j`
with coordinate pushforward along `twistedFreeNextMonomialIndex`. -/
lemma twistedFreeGradedMonomialEquiv_mulX
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) (j : Fin (n + 1)) :
    (twistedFreeGradedMonomialEquiv n R l r (d + 1) (e + 1) (by omega)).toLinearMap.comp
        (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
          j (d : ℤ)).hom) =
      (finitePiMapDomain R
          (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
            (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2))).comp
        (twistedFreeGradedMonomialEquiv n R l r d e he).toLinearMap := by
  let E := twistedFreeGradedMonomialEquiv n R l r d e he
  let B := (Pi.basisFun R
    (ULift.{u} (Fin r) × Fin ((n + e).choose n))).map E.symm
  apply B.ext
  intro ai
  have hB : B ai = E.symm (Pi.single ai 1) := by
    change E.symm
      ((Pi.basisFun R
        (ULift.{u} (Fin r) × Fin ((n + e).choose n))) ai) = _
    rw [Pi.basisFun_apply]
  rw [hB]
  simp only [LinearMap.comp_apply]
  change _ = (finitePiMapDomain R
    (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
      (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2)))
        (E (E.symm (Pi.single ai 1)))
  rw [E.apply_symm_apply]
  rw [finitePiMapDomain_single]
  let En := twistedFreeGradedMonomialEquiv
    n R l r (d + 1) (e + 1) (by omega)
  let x₀ := (ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
    R n l r (d : ℤ) e he.symm).symm
      (Pi.single ai.1.down
        (MvPolynomial.homogeneousSubmoduleFinBasis n R e ai.2))
  let y : ULift.{u} (Fin r) × Fin ((n + (e + 1)).choose n) → R :=
    Pi.single
      (ai.1, Scheme.twistedFreeNextMonomialIndex n e j ai.2) (1 : R)
  let z₀ := (ProjectiveSpace.GradedModule.freeObjHomogeneousEquiv
    R n l r ((d + 1 : ℕ) : ℤ) (e + 1) (by omega)).symm
      (Pi.single ai.1.down
        (MvPolynomial.homogeneousSubmoduleFinBasis n R (e + 1)
          (Scheme.twistedFreeNextMonomialIndex n e j ai.2)))
  have hs : E.symm (Pi.single ai 1) = x₀ :=
    twistedFreeGradedMonomialEquiv_symm_single_one
      n R l r d e he ai.1 ai.2
  have hm :
      (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
        j (d : ℤ)).hom x₀) = z₀ :=
    freeObjHomogeneousEquiv_mulX_symm_single_basis
      n R l r d e he j ai.1.down ai.2
  have hn : En.symm y = z₀ :=
    twistedFreeGradedMonomialEquiv_symm_single_one
      n R l r (d + 1) (e + 1) (by omega) ai.1
        (Scheme.twistedFreeNextMonomialIndex n e j ai.2)
  change En
      (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
        j (d : ℤ)).hom (E.symm (Pi.single ai 1))) = y
  calc
    _ = En
        (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
          j (d : ℤ)).hom x₀) :=
      congrArg (fun z ↦ En
        (((((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
          j (d : ℤ)).hom z)) hs
    _ = En z₀ := congrArg En hm
    _ = En (En.symm y) := congrArg En hn.symm
    _ = y := En.apply_symm_apply y

/-- Module-isomorphism form of `twistedFreeGradedMonomialEquiv_mulX`. -/
lemma twistedFreeGradedMonomialIso_mulX
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) (j : Fin (n + 1)) :
    (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
          j (d : ℤ) ≫
        (twistedFreeGradedMonomialEquiv
          n R l r (d + 1) (e + 1) (by omega)).toModuleIso.hom =
      (twistedFreeGradedMonomialEquiv n R l r d e he).toModuleIso.hom ≫
        ModuleCat.ofHom (finitePiMapDomain R
          (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
            (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2))) := by
  apply ModuleCat.hom_ext
  exact twistedFreeGradedMonomialEquiv_mulX n R l r d e he j

/-- Inverse-isomorphism form of `twistedFreeGradedMonomialIso_mulX`. -/
lemma finitePiMapDomain_comp_twistedFreeGradedMonomialIso_inv
    (n : ℕ) (R : Type u) [CommRing R] (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) (j : Fin (n + 1)) :
    ModuleCat.ofHom (finitePiMapDomain R
          (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
            (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2))) ≫
        (twistedFreeGradedMonomialEquiv
          n R l r (d + 1) (e + 1) (by omega)).toModuleIso.inv =
      (twistedFreeGradedMonomialEquiv n R l r d e he).toModuleIso.inv ≫
        (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
          j (d : ℤ) := by
  let Ec := (twistedFreeGradedMonomialEquiv
    n R l r d e he).toModuleIso
  let En := (twistedFreeGradedMonomialEquiv
    n R l r (d + 1) (e + 1) (by omega)).toModuleIso
  let L := ModuleCat.ofHom (finitePiMapDomain R
    (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
      (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2)))
  let m := (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
    j (d : ℤ)
  have h : m ≫ En.hom = Ec.hom ≫ L :=
    twistedFreeGradedMonomialIso_mulX n R l r d e he j
  apply (cancel_mono En.hom).1
  calc
    (L ≫ En.inv) ≫ En.hom = L := by simp
    _ = Ec.inv ≫ (Ec.hom ≫ L) := by simp
    _ = Ec.inv ≫ (m ≫ En.hom) :=
      congrArg (fun q ↦ Ec.inv ≫ q) h.symm
    _ = (Ec.inv ≫ m) ≫ En.hom := (Category.assoc _ _ _).symm

/-- The affine twisted-free degree isomorphisms carry the monomial free-sheaf
map for a variable to multiplication by that variable in the graded module. -/
lemma affineTwistedFreeDegreeIso_map_freeMap
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) (j : Fin (n + 1)) :
    moduleSpecΓFunctor.map
          (SheafOfModules.freeMap (R := (Spec R).ringCatSheaf)
            (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
              (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2))) ≫
        (affineTwistedFreeDegreeIso
          n R l r (d + 1) (e + 1) (by omega)).hom =
      (affineTwistedFreeDegreeIso n R l r d e he).hom ≫
        (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
          j (d : ℤ) := by
  let c₀ := (affineFreeCoordinateIso R
    (ULift.{u} (Fin r) × Fin ((n + e).choose n))).hom
  let c₁ := (affineFreeCoordinateIso R
    (ULift.{u} (Fin r) × Fin ((n + (e + 1)).choose n))).hom
  let E₀ := (twistedFreeGradedMonomialEquiv
    n R l r d e he).toModuleIso
  let E₁ := (twistedFreeGradedMonomialEquiv
    n R l r (d + 1) (e + 1) (by omega)).toModuleIso
  let L := ModuleCat.ofHom (finitePiMapDomain R
    (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
      (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2)))
  let g := moduleSpecΓFunctor.map
    (SheafOfModules.freeMap (R := (Spec R).ringCatSheaf)
      (fun x : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
        (x.1, Scheme.twistedFreeNextMonomialIndex n e j x.2)))
  let m := (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r).mulX
    j (d : ℤ)
  have hg : g ≫ c₁ = c₀ ≫ L :=
    affineFreeCoordinateIso_map_freeMap R _
  have hL : L ≫ E₁.inv = E₀.inv ≫ m :=
    finitePiMapDomain_comp_twistedFreeGradedMonomialIso_inv
      n R l r d e he j
  change g ≫ c₁ ≫ E₁.inv = c₀ ≫ E₀.inv ≫ m
  calc
    g ≫ c₁ ≫ E₁.inv = (g ≫ c₁) ≫ E₁.inv :=
      (Category.assoc _ _ _).symm
    _ = (c₀ ≫ L) ≫ E₁.inv :=
      congrArg (fun q ↦ q ≫ E₁.inv) hg
    _ = c₀ ≫ (L ≫ E₁.inv) := Category.assoc _ _ _
    _ = c₀ ≫ (E₀.inv ≫ m) := congrArg (fun q ↦ c₀ ≫ q) hL
    _ = c₀ ≫ E₀.inv ≫ m := (Category.assoc _ _ _).symm

/-- The inverse affine coproduct isomorphism sends a single-coordinate tuple to
the corresponding affine-section coproduct injection. -/
lemma affineKernelVariableCoproductIso_inv_single
    (n : ℕ) (R : CommRingCat.{u}) {E : (Spec R).Modules}
    {I : Type u}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf) I ⟶ E)
    (j : Fin (n + 1))
    (x : (Scheme.Modules.specEvaluation R ⊤).obj (kernel u)) :
    (affineKernelVariableCoproductIso n R u).inv.hom (Pi.single j x) =
      ((Scheme.Modules.specEvaluation R ⊤).map
        (Sigma.ι (fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u)
          (ULift.up j))).hom x := by
  let S := affineKernelVariableCoproductIso n R u
  let y := ((Scheme.Modules.specEvaluation R ⊤).map
    (Sigma.ι (fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u)
      (ULift.up j))).hom x
  have h : S.hom.hom y = Pi.single j x :=
    affineKernelVariableCoproductIso_hom_map_ι
      n R u (ULift.up j) x
  change S.inv.hom (Pi.single j x) = y
  calc
    S.inv.hom (Pi.single j x) = S.inv.hom (S.hom.hom y) :=
      congrArg S.inv.hom h.symm
    _ = y := S.hom_inv_id_apply y

set_option maxHeartbeats 900000 in
-- The proof unfolds a finite coproduct, affine sections, and graded coordinates.
/-- After identifying both sources and targets in affine monomial coordinates,
the finite sheaf-theoretic next-degree relation agrees with the successor
relation of the generated graded quotient.

The proof unfolds a finite coproduct, affine sections, and graded coordinates. -/
lemma affineTwistedFreeNextDegreeRelation_square
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) {E : (Spec R).Modules}
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ⟶ E) :
    (Scheme.Modules.specEvaluation R ⊤).map
          (Scheme.twistedFreeNextDegreeRelation n (Spec R) r e u) ≫
        (affineTwistedFreeDegreeIso
          n R l r (d + 1) (e + 1) (by omega)).hom =
      (affineKernelVariableCoproductIso n R u).hom ≫
        ProjectiveSpace.GradedModule.freeOnModuleVariableRelation
          (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r)
          (d : ℤ) ((Scheme.Modules.specEvaluation R ⊤).obj (kernel u))
          (affineReconstructedKernelRelation n R l r d e he u) := by
  let G := moduleSpecΓFunctor (R := R)
  let S := affineKernelVariableCoproductIso n R u
  let A₀ := affineTwistedFreeDegreeIso n R l r d e he
  let A₁ := affineTwistedFreeDegreeIso
    n R l r (d + 1) (e + 1) (by omega)
  let M := (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r)
  let f := affineReconstructedKernelRelation n R l r d e he u
  let g := ProjectiveSpace.GradedModule.freeOnModuleVariableRelation
    M (d : ℤ) (G.obj (kernel u)) f
  let rel := Scheme.twistedFreeNextDegreeRelation n (Spec R) r e u
  apply (cancel_epi S.inv).1
  change S.inv ≫ (G.map rel ≫ A₁.hom) =
    S.inv ≫ (S.hom ≫ g)
  rw [Iso.inv_hom_id_assoc]
  apply ModuleCat.hom_ext
  apply LinearMap.pi_ext
  intro j x
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply]
  rw [affineKernelVariableCoproductIso_inv_single n R u j x]
  let ιj := Sigma.ι
    (fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u) (ULift.up j)
  let φj := fun z : ULift.{u} (Fin r) × Fin ((n + e).choose n) ↦
    (z.1, Scheme.twistedFreeNextMonomialIndex n e j z.2)
  have hι : ιj ≫ rel = kernel.ι u ≫
      SheafOfModules.freeMap (R := (Spec R).ringCatSheaf) φj := by
    dsimp only [ιj, rel, Scheme.twistedFreeNextDegreeRelation]
    rw [Sigma.ι_desc]
  have hmap : G.map ιj ≫ G.map rel =
      G.map (kernel.ι u) ≫
        G.map (SheafOfModules.freeMap
          (R := (Spec R).ringCatSheaf) φj) := by
    calc
      G.map ιj ≫ G.map rel = G.map (ιj ≫ rel) :=
        (G.map_comp ιj rel).symm
      _ = G.map (kernel.ι u ≫
          SheafOfModules.freeMap
            (R := (Spec R).ringCatSheaf) φj) := congrArg G.map hι
      _ = G.map (kernel.ι u) ≫
          G.map (SheafOfModules.freeMap
            (R := (Spec R).ringCatSheaf) φj) :=
        G.map_comp _ _
  have hamb : G.map (SheafOfModules.freeMap
        (R := (Spec R).ringCatSheaf) φj) ≫ A₁.hom =
      A₀.hom ≫ M.mulX j (d : ℤ) := by
    exact affineTwistedFreeDegreeIso_map_freeMap n R l r d e he j
  have hj : G.map ιj ≫ G.map rel ≫ A₁.hom =
      G.map (kernel.ι u) ≫ A₀.hom ≫ M.mulX j (d : ℤ) := by
    calc
      G.map ιj ≫ G.map rel ≫ A₁.hom =
          (G.map ιj ≫ G.map rel) ≫ A₁.hom :=
        (Category.assoc _ _ _).symm
      _ = (G.map (kernel.ι u) ≫
          G.map (SheafOfModules.freeMap
            (R := (Spec R).ringCatSheaf) φj)) ≫ A₁.hom :=
        congrArg (fun q ↦ q ≫ A₁.hom) hmap
      _ = G.map (kernel.ι u) ≫
          (G.map (SheafOfModules.freeMap
            (R := (Spec R).ringCatSheaf) φj) ≫ A₁.hom) :=
        Category.assoc _ _ _
      _ = G.map (kernel.ι u) ≫
          (A₀.hom ≫ M.mulX j (d : ℤ)) :=
        congrArg (fun q ↦ G.map (kernel.ι u) ≫ q) hamb
      _ = G.map (kernel.ι u) ≫ A₀.hom ≫ M.mulX j (d : ℤ) :=
        (Category.assoc _ _ _).symm
  have hjx := congrArg (fun q ↦ q.hom x) hj
  change (G.map ιj ≫ G.map rel ≫ A₁.hom).hom x = g.hom (Pi.single j x)
  rw [hjx]
  rw [ProjectiveSpace.GradedModule.freeOnModuleVariableRelation_single]
  change (M.mulX j (d : ℤ)).hom (f.hom x) = _
  rw [mulFormZ_freeOnModuleSuccBasisElement_variable]
  rfl

/-- Affine sections carry a cokernel of quasicoherent sheaves on `Spec R` to the
cokernel of the induced map of `R`-modules. -/
noncomputable def affineCokernelIso
    (R : CommRingCat.{u}) {N M : (Spec R).Modules}
    [N.IsQuasicoherent] [M.IsQuasicoherent] (i : N ⟶ M) :
    cokernel (moduleSpecΓFunctor.map i) ≅
      moduleSpecΓFunctor.obj (cokernel i) :=
  tilde.toTildeΓNatIso.app (cokernel (moduleSpecΓFunctor.map i)) ≪≫
    moduleSpecΓFunctor.mapIso
      (Scheme.Modules.quasicoherentCokernelSpecTildeIso i).symm

set_option maxHeartbeats 600000 in
-- Typechecking expands both the generated quotient and the affine cokernel bridge.
/-- The degree immediately after the generating degree of the affine generated
graded quotient is the affine module of the finite twisted-free next-degree
cokernel.

This is an affine, degreewise monomial comparison and requires no geometric
pushforward base-change theorem. Typechecking the composite expands both the
generated quotient and the affine cokernel bridge. -/
noncomputable def affineReconstructedGeneratedGradedQuotientSuccIso
    (n : ℕ) (R : CommRingCat.{u}) (l : ℤ) (r d e : ℕ)
    (he : (d : ℤ) - l = (e : ℤ)) {E : (Spec R).Modules}
    [E.IsQuasicoherent]
    (u : SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) × Fin ((n + e).choose n)) ⟶ E) :
    (affineReconstructedGeneratedGradedQuotient
        n R l r d e he u).obj ((d : ℤ) + 1) ≅
      moduleSpecΓFunctor.obj
        (Scheme.twistedFreeNextDegreeModule n (Spec R) r e u) := by
  letI : (kernel u).IsQuasicoherent :=
    Scheme.Modules.kernel_isQuasicoherent u
  letI : (∐ fun _ : ULift.{u} (Fin (n + 1)) ↦ kernel u).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_coproduct _
  letI : (SheafOfModules.free (R := (Spec R).ringCatSheaf)
      (ULift.{u} (Fin r) ×
        Fin ((n + (e + 1)).choose n))).IsQuasicoherent := by
    infer_instance
  let M := (((ProjectiveSpace.GradedModule.structureModule R n).twist (-l)).pow r)
  let K := (Scheme.Modules.specEvaluation R ⊤).obj (kernel u)
  let f := affineReconstructedKernelRelation n R l r d e he u
  let rel := Scheme.twistedFreeNextDegreeRelation n (Spec R) r e u
  let grel := ProjectiveSpace.GradedModule.freeOnModuleVariableRelation
    M (d : ℤ) K f
  let ciso : cokernel (moduleSpecΓFunctor.map rel) ≅ cokernel grel :=
    cokernel.mapIso
      (moduleSpecΓFunctor.map rel) grel
      (affineKernelVariableCoproductIso n R u)
      (affineTwistedFreeDegreeIso
        n R l r (d + 1) (e + 1) (by omega))
      (affineTwistedFreeNextDegreeRelation_square
        n R l r d e he u)
  exact
    ProjectiveSpace.GradedModule.generatedQuotientVariableSuccIso
        M (d : ℤ) K f ≪≫
      ciso.symm ≪≫
      affineCokernelIso R rel

end


