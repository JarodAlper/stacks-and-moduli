  have hRd := pullbackWedgeApp_ιMulti f W q U (fun i ↦ show Γ(W, U) from (φ.app U) (m i))
  -- assemble both sides in term mode (the spellings defeat `rw`)
  have hun : (((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
        (Scheme.Modules.exteriorPower W q)).app U)
        (((Scheme.Modules.exteriorPowerMap φ q).app U)
          (((Scheme.Modules.toExteriorPower V q).app (Opposite.op U)).hom
            (exteriorPower.ιMulti Γ(S, U) q m))) =
      (((Scheme.Modules.pullback f).map
        (Scheme.Modules.exteriorPowerMap φ q)).app (f ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
          (Scheme.Modules.exteriorPower V q)).app U)
          (((Scheme.Modules.toExteriorPower V q).app (Opposite.op U)).hom
            (exteriorPower.ιMulti Γ(S, U) q m))) := hunitnat
  refine hLa.trans (Eq.trans ?_ hRa.symm)
  have hL := (congrArg (fun y ↦
      ((Scheme.Modules.exteriorPowerMap ((Scheme.Modules.pullback f).map φ) q).app
        (f ⁻¹ᵁ U)) y) hLb).trans
    ((congrArg (fun y ↦
        ((Scheme.Modules.exteriorPowerMap ((Scheme.Modules.pullback f).map φ) q).app
          (f ⁻¹ᵁ U)) y) hLc).trans
      (hLd.trans (congrArg (ConcreteCategory.hom
        ((Scheme.Modules.toExteriorPower
          ((Scheme.Modules.pullback f).obj W) q).app (Opposite.op (f ⁻¹ᵁ U))))
        (congrArg (exteriorPower.ιMulti Γ(T, f ⁻¹ᵁ U) q) (funext hunitφ)))))
  have hR := (congrArg (fun y ↦
      ((pullbackExteriorPower f W q).app (f ⁻¹ᵁ U)) y) hun).symm.trans
    ((congrArg (fun y ↦
        ((pullbackExteriorPower f W q).app (f ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
            (Scheme.Modules.exteriorPower W q)).app U) y)) hbase).trans
      (hRc.trans hRd))
  exact hL.trans hR.symm


section CompatibilityWithComposition

variable {X Y Z : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ Z)

set_option maxHeartbeats 1600000 in
-- the mate identity for `pullbackComp` unfolds heavy functor composites
/-- **The pullback-adjunction units compose**: the unit for a composite morphism, followed
by the comparison of iterated pullbacks, is the composite of the two units. -/
lemma unit_app_comp (W : Z.Modules) (U : Z.Opens) (s : Γ(W, U)) :
    (((Scheme.Modules.pullbackComp a b).inv.app W).app ((a ≫ b) ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction (a ≫ b)).unit.app W).app U) s) =
      (((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
        ((Scheme.Modules.pullback b).obj W)).app (b ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app W).app U) s) := by
  have hconj := CategoryTheory.unit_conjugateEquiv
    ((Scheme.Modules.pullbackPushforwardAdjunction b).comp
      (Scheme.Modules.pullbackPushforwardAdjunction a))
    (Scheme.Modules.pullbackPushforwardAdjunction (a ≫ b))
    (Scheme.Modules.pullbackComp a b).inv W
  rw [Scheme.Modules.conjugateEquiv_pullbackComp_inv] at hconj
  -- evaluate the identity of morphisms of sheaves on `Z` at `U`, on `s`
  have hev := congrArg
    (fun (k : W ⟶ (Scheme.Modules.pushforward a ⋙
        Scheme.Modules.pushforward b).obj
        ((Scheme.Modules.pullback b ⋙ Scheme.Modules.pullback a).obj W)) ↦
      (k.app U) s) hconj
  exact hev.symm


set_option maxHeartbeats 3200000 in
-- the composite comparison is checked on unit wedges, one factor at a time
/-- **Compatibility of the exterior-power pullback comparison with composition.** -/
theorem pullbackExteriorPower_comp (W : Z.Modules) (q : ℕ) :
    pullbackExteriorPower (a ≫ b) W q =
      (Scheme.Modules.pullbackComp a b).inv.app (Scheme.Modules.exteriorPower W q) ≫
        (Scheme.Modules.pullback a).map (pullbackExteriorPower b W q) ≫
        pullbackExteriorPower a ((Scheme.Modules.pullback b).obj W) q ≫
        Scheme.Modules.exteriorPowerMap
          ((Scheme.Modules.pullbackComp a b).hom.app W) q := by
  refine hom_ext_of_unit_ιMulti (a ≫ b) W q _ _ ?_
  intro U m
  -- the left-hand side is the wedge of the composite unit sections
  have hL := (pullbackExteriorPower_app_unit (a ≫ b) W q U
    (exteriorPower.ιMulti Γ(Z, U) q m)).trans
    (pullbackWedgeApp_ιMulti (a ≫ b) W q U m)
  -- the right-hand side, factor by factor
  have h1 := unit_app_comp a b (Scheme.Modules.exteriorPower W q) U
    (((Scheme.Modules.toExteriorPower W q).app (Opposite.op U)).hom
      (exteriorPower.ιMulti Γ(Z, U) q m))
  have h2 : ∀ (z : Γ((Scheme.Modules.pullback b).obj
      (Scheme.Modules.exteriorPower W q), b ⁻¹ᵁ U)),
      (((Scheme.Modules.pullback a).map (pullbackExteriorPower b W q)).app
          (a ⁻¹ᵁ (b ⁻¹ᵁ U)))
        ((((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
          ((Scheme.Modules.pullback b).obj
            (Scheme.Modules.exteriorPower W q))).app (b ⁻¹ᵁ U)) z) =
        (((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
          (Scheme.Modules.exteriorPower ((Scheme.Modules.pullback b).obj W) q)).app
            (b ⁻¹ᵁ U))
          (((pullbackExteriorPower b W q).app (b ⁻¹ᵁ U)) z) := by
    intro z
    exact (congrArg
      (fun (k : (Scheme.Modules.pullback b).obj (Scheme.Modules.exteriorPower W q) ⟶
          (Scheme.Modules.pushforward a).obj ((Scheme.Modules.pullback a).obj
            (Scheme.Modules.exteriorPower ((Scheme.Modules.pullback b).obj W) q))) ↦
        (k.app (b ⁻¹ᵁ U)) z)
      ((Scheme.Modules.pullbackPushforwardAdjunction a).unit.naturality
        (pullbackExteriorPower b W q))).symm
  have h3 := (pullbackExteriorPower_app_unit b W q U
    (exteriorPower.ιMulti Γ(Z, U) q m)).trans
    (pullbackWedgeApp_ιMulti b W q U m)
  have h4 := (pullbackExteriorPower_app_unit a ((Scheme.Modules.pullback b).obj W) q
    (b ⁻¹ᵁ U)
    (exteriorPower.ιMulti Γ(Y, b ⁻¹ᵁ U) q
      (fun i ↦ show Γ((Scheme.Modules.pullback b).obj W, b ⁻¹ᵁ U) from
        (((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app W).app U) (m i)))).trans
    (pullbackWedgeApp_ιMulti a ((Scheme.Modules.pullback b).obj W) q (b ⁻¹ᵁ U)
      (fun i ↦ show Γ((Scheme.Modules.pullback b).obj W, b ⁻¹ᵁ U) from
        (((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app W).app U) (m i)))
  have h5 := Scheme.Modules.exteriorPowerMap_app_unit_ιMulti
    ((Scheme.Modules.pullbackComp a b).hom.app W) q (a ⁻¹ᵁ (b ⁻¹ᵁ U))
    (fun i ↦ show Γ((Scheme.Modules.pullback a).obj
        ((Scheme.Modules.pullback b).obj W), a ⁻¹ᵁ (b ⁻¹ᵁ U)) from
      (((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
        ((Scheme.Modules.pullback b).obj W)).app (b ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app W).app U) (m i)))
  -- the comparison sends the iterated unit back to the composite unit
  have hback : ∀ (i : Fin q),
      (((Scheme.Modules.pullbackComp a b).hom.app W).app (a ⁻¹ᵁ (b ⁻¹ᵁ U)))
          ((((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
            ((Scheme.Modules.pullback b).obj W)).app (b ⁻¹ᵁ U))
            ((((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app W).app U)
              (m i))) =
        (((Scheme.Modules.pullbackPushforwardAdjunction (a ≫ b)).unit.app W).app U)
          (m i) := by
    intro i
    have hcomp := unit_app_comp a b W U (m i)
    have happ := congrArg
      (fun y ↦ (((Scheme.Modules.pullbackComp a b).hom.app W).app
        ((a ≫ b) ⁻¹ᵁ U)) y) hcomp
    refine happ.symm.trans ?_
    exact congrArg
      (fun (k : (Scheme.Modules.pullback (a ≫ b)).obj W ⟶
          (Scheme.Modules.pullback (a ≫ b)).obj W) ↦
        (k.app ((a ≫ b) ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackPushforwardAdjunction (a ≫ b)).unit.app W).app U)
            (m i)))
      ((Scheme.Modules.pullbackComp a b).inv_hom_id_app W)
  -- assemble
  refine hL.trans ?_
  show _ =
    ((Scheme.Modules.exteriorPowerMap
        ((Scheme.Modules.pullbackComp a b).hom.app W) q).app (a ⁻¹ᵁ b ⁻¹ᵁ U))
      (((pullbackExteriorPower a ((Scheme.Modules.pullback b).obj W) q).app
          (a ⁻¹ᵁ b ⁻¹ᵁ U))
        ((((Scheme.Modules.pullback a).map (pullbackExteriorPower b W q)).app
            (a ⁻¹ᵁ b ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackComp a b).inv.app
              (Scheme.Modules.exteriorPower W q)).app (a ⁻¹ᵁ b ⁻¹ᵁ U))
            ((((Scheme.Modules.pullbackPushforwardAdjunction (a ≫ b)).unit.app
                (Scheme.Modules.exteriorPower W q)).app U)
              (((Scheme.Modules.toExteriorPower W q).app (Opposite.op U)).hom
                (exteriorPower.ιMulti Γ(Z, U) q m))))))
  have h1' : (((Scheme.Modules.pullbackComp a b).inv.app
        (Scheme.Modules.exteriorPower W q)).app (a ⁻¹ᵁ b ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction (a ≫ b)).unit.app
          (Scheme.Modules.exteriorPower W q)).app U)
          (((Scheme.Modules.toExteriorPower W q).app (Opposite.op U)).hom
            (exteriorPower.ιMulti Γ(Z, U) q m))) =
      (((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
        ((Scheme.Modules.pullback b).obj (Scheme.Modules.exteriorPower W q))).app
          (b ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app
          (Scheme.Modules.exteriorPower W q)).app U)
          (((Scheme.Modules.toExteriorPower W q).app (Opposite.op U)).hom
            (exteriorPower.ιMulti Γ(Z, U) q m))) := h1
  rw [h1', h2]
  -- the remaining steps go through `congrArg` (the spellings defeat `rw`)
  refine Eq.trans ?_ ((congrArg (fun y ↦
      ((Scheme.Modules.exteriorPowerMap
          ((Scheme.Modules.pullbackComp a b).hom.app W) q).app (a ⁻¹ᵁ b ⁻¹ᵁ U))
        (((pullbackExteriorPower a ((Scheme.Modules.pullback b).obj W) q).app
            (a ⁻¹ᵁ b ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackPushforwardAdjunction a).unit.app
              (Scheme.Modules.exteriorPower
                ((Scheme.Modules.pullback b).obj W) q)).app (b ⁻¹ᵁ U)) y))) h3).symm)
  refine Eq.trans ?_ ((congrArg (fun y ↦
      ((Scheme.Modules.exteriorPowerMap
          ((Scheme.Modules.pullbackComp a b).hom.app W) q).app
            (a ⁻¹ᵁ b ⁻¹ᵁ U)) y) h4).symm)
  refine Eq.trans ?_ h5.symm
  exact congrArg (ConcreteCategory.hom
    ((Scheme.Modules.toExteriorPower
      ((Scheme.Modules.pullback (a ≫ b)).obj W) q).app
        (Opposite.op (a ⁻¹ᵁ b ⁻¹ᵁ U))))
    (congrArg (exteriorPower.ιMulti Γ(X, a ⁻¹ᵁ b ⁻¹ᵁ U) q) (funext hback)).symm


/-- The exterior-power pullback comparison transports along an equality of morphisms. -/
lemma pullbackExteriorPower_congr {X Y : Scheme.{u}} {c d : X ⟶ Y} (h : c = d)
    (W : Y.Modules) (q : ℕ) :
    pullbackExteriorPower d W q =
      (Scheme.Modules.pullbackCongr h).inv.app (Scheme.Modules.exteriorPower W q) ≫
        pullbackExteriorPower c W q ≫
        Scheme.Modules.exteriorPowerMap
          ((Scheme.Modules.pullbackCongr h).hom.app W) q := by
  subst h
  have hcongr : Scheme.Modules.pullbackCongr (rfl : c = c) = Iso.refl _ := rfl
  rw [hcongr]
  rw [show (Iso.refl (Scheme.Modules.pullback c)).inv.app
      (Scheme.Modules.exteriorPower W q) = 𝟙 _ from rfl,
    show (Iso.refl (Scheme.Modules.pullback c)).hom.app W = 𝟙 _ from rfl,
    Scheme.Modules.exteriorPowerMap_id, Category.comp_id, Category.id_comp]


end CompatibilityWithComposition


end PullbackExteriorPowerEpi

