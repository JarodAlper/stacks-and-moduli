module

public import Mathlib.CategoryTheory.Adjunction.Additive
public import StacksAndModuli.API.OpenCoverQuotient
public import StacksAndModuli.API.ExteriorPowerPullback

/-!
# The pullback of a sheaf of modules is generated by unit sections

Supporting API with no Stacks Project counterpart of its own, consumed by the relative
Plücker embedding of **Theorem 2.1.1**: for a morphism of schemes `f : T ⟶ S` and a sheaf
of modules `V` on `S`, every section of `(pullback f).obj V` lies locally in the span of
restrictions of unit sections (images of sections of `V` under the pullback-adjunction
unit).

The proof is completely formal: the locally-spanned sections form a subsheaf (via
`localSubmoduleSheaf`), the quotient map kills all unit sections, and a morphism out of
the pullback killing all unit sections is zero, because its adjoint transpose vanishes
sectionwise.  Hence the quotient vanishes and the inclusion is an isomorphism.
-/

@[expose] public section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option maxSynthPendingDepth 10
set_option linter.style.haveILetI false

universe u

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry

open AlgebraicGeometry.Scheme

variable {T S : Scheme.{u}} (f : T ⟶ S) (V : S.Modules)

/-- The unit sections of the pullback over an open `W ⊆ T`: restrictions of images of
sections of `V` over opens `U ⊆ S` with `W ⊆ f⁻¹U` under the pullback-adjunction
unit. -/
def pullbackUnitSet (W : T.Opens) :
    Set Γ((Scheme.Modules.pullback f).obj V, W) :=
  ⋃ (U : S.Opens) (h : W ≤ f ⁻¹ᵁ U),
    Set.range (fun v : Γ(V, U) ↦
      (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map (homOfLE h).op
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v))

/-- The presheaf of spans of unit sections. -/
noncomputable def pullbackUnitRawSpan :
    ((Scheme.Modules.pullback f).obj V).val.Submodule where
  obj W := Submodule.span Γ(T, W.unop) (pullbackUnitSet f V W.unop)
  map {W W'} g := by
    rw [Submodule.span_le]
    rintro s hs
    refine Submodule.mem_comap.mpr ?_
    obtain ⟨SU, ⟨U, rfl⟩, hSU⟩ := hs
    obtain ⟨SV, ⟨hWU, rfl⟩, hmem⟩ := hSU
    obtain ⟨v, rfl⟩ := hmem
    have hW'U : W'.unop ≤ f ⁻¹ᵁ U := (leOfHom g.unop).trans hWU
    have hcomp := _root_.PresheafOfModules.map_comp_apply
      (M := ((Scheme.Modules.pullback f).obj V).val) (homOfLE hWU).op g
      ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v)
    refine Submodule.subset_span ?_
    exact Set.mem_iUnion.mpr ⟨U, Set.mem_iUnion.mpr ⟨hW'U, ⟨v, hcomp⟩⟩⟩

/-- The presheaf of sections locally in the span of unit sections. -/
noncomputable def pullbackUnitLocalSpan :
    ((Scheme.Modules.pullback f).obj V).val.Submodule where
  obj W :=
    { carrier := { s | ∀ x ∈ W.unop, ∃ (W' : T.Opens) (h : W' ≤ W.unop), x ∈ W' ∧
        (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
          (homOfLE h).op s ∈ (pullbackUnitRawSpan f V).obj (Opposite.op W') }
      add_mem' := by
        rintro s t hs ht x hx
        obtain ⟨W₁, h₁, hx₁, hm₁⟩ := hs x hx
        obtain ⟨W₂, h₂, hx₂, hm₂⟩ := ht x hx
        refine ⟨W₁ ⊓ W₂, inf_le_left.trans h₁, ⟨hx₁, hx₂⟩, ?_⟩
        rw [map_add]
        refine Submodule.add_mem _ ?_ ?_
        · have hc : (Scheme.Modules.presheaf
              ((Scheme.Modules.pullback f).obj V)).map
                (homOfLE (inf_le_left.trans h₁ :
                  W₁ ⊓ W₂ ≤ W.unop)).op s =
              (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
                (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op
                ((Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
                  (homOfLE h₁).op s) :=
            _root_.PresheafOfModules.map_comp_apply
              (M := ((Scheme.Modules.pullback f).obj V).val) (homOfLE h₁).op
              (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op s
          exact hc ▸ (pullbackUnitRawSpan f V).map_mem
            (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op hm₁
        · have hc : (Scheme.Modules.presheaf
              ((Scheme.Modules.pullback f).obj V)).map
                (homOfLE (inf_le_left.trans h₁ :
                  W₁ ⊓ W₂ ≤ W.unop)).op t =
              (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
                (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op
                ((Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
                  (homOfLE h₂).op t) :=
            _root_.PresheafOfModules.map_comp_apply
              (M := ((Scheme.Modules.pullback f).obj V).val) (homOfLE h₂).op
              (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op t
          exact hc ▸ (pullbackUnitRawSpan f V).map_mem
            (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op hm₂
      zero_mem' := by
        intro x hx
        exact ⟨W.unop, le_rfl, hx, by rw [map_zero]; exact Submodule.zero_mem _⟩
      smul_mem' := by
        rintro c s hs x hx
        obtain ⟨W₁, h₁, hx₁, hm₁⟩ := hs x hx
        refine ⟨W₁, h₁, hx₁, ?_⟩
        have hsm := Scheme.Modules.map_smul
          (M := (Scheme.Modules.pullback f).obj V) (homOfLE h₁) c s
        exact hsm ▸ Submodule.smul_mem _ _ hm₁ }
  map {W W'} g := by
    intro s hs
    refine Submodule.mem_comap.mpr ?_
    intro x hx
    obtain ⟨W₁, h₁, hx₁, hm₁⟩ := hs x ((leOfHom g.unop) hx)
    refine ⟨W₁ ⊓ W'.unop, inf_le_right, ⟨hx₁, hx⟩, ?_⟩
    have hc₁ : (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE (inf_le_right : W₁ ⊓ W'.unop ≤ W'.unop)).op
          ((Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map g s) =
        (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
          (homOfLE (inf_le_left : W₁ ⊓ W'.unop ≤ W₁)).op
            ((Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
              (homOfLE h₁).op s) := by
      refine Eq.trans (_root_.PresheafOfModules.map_comp_apply
        (M := ((Scheme.Modules.pullback f).obj V).val) g
        (homOfLE (inf_le_right : W₁ ⊓ W'.unop ≤ W'.unop)).op s).symm ?_
      exact _root_.PresheafOfModules.map_comp_apply
        (M := ((Scheme.Modules.pullback f).obj V).val) (homOfLE h₁).op
        (homOfLE (inf_le_left : W₁ ⊓ W'.unop ≤ W₁)).op s
    exact hc₁ ▸ (pullbackUnitRawSpan f V).map_mem
      (homOfLE (inf_le_left : W₁ ⊓ W'.unop ≤ W₁)).op hm₁

/-- The local-span condition is local. -/
lemma pullbackUnitLocalSpan_isLocal :
    Scheme.Modules.PresheafSubmoduleIsLocal (pullbackUnitLocalSpan f V) := by
  intro ι Wl W hW hl s h
  intro x hx
  obtain ⟨l, hxl⟩ := TopologicalSpace.Opens.mem_iSup.mp (hW hx)
  obtain ⟨W₁, h₁, hx₁, hm₁⟩ := h l x hxl
  refine ⟨W₁, h₁.trans (hl l), hx₁, ?_⟩
  have hc : (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
      (homOfLE (h₁.trans (hl l))).op s =
      (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE h₁).op
        ((Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
          (homOfLE (hl l)).op s) :=
    _root_.PresheafOfModules.map_comp_apply
      (M := ((Scheme.Modules.pullback f).obj V).val) (homOfLE (hl l)).op
      (homOfLE h₁).op s
  exact hc ▸ hm₁

/-- The subsheaf of sections locally spanned by unit sections. -/
noncomputable def pullbackUnitSubsheaf : T.Modules :=
  Scheme.Modules.localSubmoduleSheaf (pullbackUnitLocalSpan f V)
    (pullbackUnitLocalSpan_isLocal f V)

/-- A morphism out of a pullback that kills all unit sections is zero. -/
lemma eq_zero_of_unit_sections_zero {K : T.Modules}
    (v : (Scheme.Modules.pullback f).obj V ⟶ K)
    (h : ∀ (U : S.Opens) (s : Γ(V, U)),
      (v.app (f ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s) = 0) :
    v = 0 := by
  have hT : (Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv V K v = 0 := by
    refine Scheme.Modules.hom_ext _ _ fun U ↦ ?_
    ext s
    have hcomp : ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv V K v).app U s =
        (v.app (f ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s) := by
      have := (Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv_unit
        (X := V) (Y := K) (f := v)
      rw [this]
      rfl
    rw [hcomp, h U s]
    rfl
  have hsym := congrArg
    ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv V K).symm hT
  rw [Equiv.symm_apply_apply] at hsym
  rw [hsym, Adjunction.homEquiv_counit]
  haveI : (Scheme.Modules.pullback f).Additive :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).left_adjoint_additive
  rw [Functor.map_zero, Limits.zero_comp]

set_option maxHeartbeats 1600000 in
-- the cokernel argument crosses defeq spellings of sections of the subsheaf
/-- **The pullback of a sheaf of modules is generated by unit sections**: every section
of `(pullback f).obj V` lies, locally at each point, in the span of restrictions of
images of sections of `V` under the pullback-adjunction unit. -/
theorem pullback_sections_locally_spanned (W : T.Opens)
    (s : Γ((Scheme.Modules.pullback f).obj V, W)) (x : ↥T) (hx : x ∈ W) :
    ∃ (W' : T.Opens) (h : W' ≤ W), x ∈ W' ∧
      (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE h).op s ∈ (pullbackUnitRawSpan f V).obj (Opposite.op W') := by
  set ι := Scheme.Modules.localSubmoduleSheafι (pullbackUnitLocalSpan f V)
    (pullbackUnitLocalSpan_isLocal f V) with hι
  -- unit sections belong to the local-span subsheaf
  have hunitmem : ∀ (U : S.Opens) (v : Γ(V, U)),
      ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v) ∈
        (pullbackUnitLocalSpan f V).obj (Opposite.op (f ⁻¹ᵁ U)) := by
    intro U v
    intro y hy
    refine ⟨f ⁻¹ᵁ U, le_rfl, hy, ?_⟩
    refine Submodule.subset_span ?_
    exact Set.mem_iUnion.mpr ⟨U, Set.mem_iUnion.mpr ⟨le_rfl, ⟨v, rfl⟩⟩⟩
  -- the cokernel projection kills the unit sections, hence vanishes
  have hkill : ∀ (U : S.Opens) (v : Γ(V, U)),
      ((Limits.cokernel.π ι).app (f ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v) = 0 := by
    intro U v
    have hfac : (((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v =
        (ι.app (f ⁻¹ᵁ U))
          (show Γ(pullbackUnitSubsheaf f V, f ⁻¹ᵁ U) from
            ⟨(((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v,
              hunitmem U v⟩) := rfl
    rw [hfac]
    have hcond := Scheme.Modules.Hom.comp_app
      (φ := ι) (ψ := Limits.cokernel.π ι) (U := f ⁻¹ᵁ U)
    have hzero : (ι ≫ Limits.cokernel.π ι).app (f ⁻¹ᵁ U) = 0 := by
      rw [Limits.cokernel.condition]
      rfl
    have := CategoryTheory.congr_fun (hcond.symm.trans hzero)
      (show Γ(pullbackUnitSubsheaf f V, f ⁻¹ᵁ U) from
        ⟨(((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v,
          hunitmem U v⟩)
    exact this.trans rfl
  have hπ : Limits.cokernel.π ι = 0 := eq_zero_of_unit_sections_zero f V _ hkill
  haveI : Epi ι := Abelian.epi_of_cokernel_π_eq_zero _ hπ
  haveI : IsIso ι := isIso_of_mono_of_epi ι
  -- surjectivity of the inclusion on sections gives the local-span condition
  haveI : IsIso (ι.app W) := Scheme.Modules.Hom.isIso_iff_isIso_app.mp inferInstance W
  obtain ⟨t, ht⟩ := (ConcreteCategory.bijective_of_isIso (ι.app W)).2 s
  obtain ⟨W', h, hxW', hmem⟩ := t.2 x hx
  refine ⟨W', h, hxW', ?_⟩
  have hnat : (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
      (homOfLE h).op s =
      (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE h).op ((ι.app W) t) := by rw [ht]
  rw [hnat]
  exact hmem

/-- The unit-section characterization, packaged as membership in the span. -/
lemma mem_span_unitSet_of_mem_rawSpan {W : T.Opens}
    {s : Γ((Scheme.Modules.pullback f).obj V, W)}
    (h : s ∈ (pullbackUnitRawSpan f V).obj (Opposite.op W)) :
    s ∈ Submodule.span Γ(T, W) (pullbackUnitSet f V W) := h

/-- Sections of a pullback are locally in the span of the unit sections. -/
theorem pullback_mem_span_unitSet (W : T.Opens)
    (s : Γ((Scheme.Modules.pullback f).obj V, W)) (x : ↥T) (hx : x ∈ W) :
    ∃ (W' : T.Opens) (h : W' ≤ W), x ∈ W' ∧
      (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE h).op s ∈ Submodule.span Γ(T, W') (pullbackUnitSet f V W') := by
  obtain ⟨W', h, hxW', hmem⟩ := pullback_sections_locally_spanned f V W s x hx
  exact ⟨W', h, hxW', mem_span_unitSet_of_mem_rawSpan f V hmem⟩

/-- Restriction of a unit section is a unit section. -/
lemma pullbackUnitSet_restrict {W W' : T.Opens} (h : W' ≤ W)
    {s : Γ((Scheme.Modules.pullback f).obj V, W)} (hs : s ∈ pullbackUnitSet f V W) :
    (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map (homOfLE h).op s
      ∈ pullbackUnitSet f V W' := by
  obtain ⟨SU, ⟨U, rfl⟩, hSU⟩ := hs
  obtain ⟨SV, ⟨hWU, rfl⟩, ⟨v, rfl⟩⟩ := hSU
  refine Set.mem_iUnion.mpr ⟨U, Set.mem_iUnion.mpr ⟨h.trans hWU, ⟨v, ?_⟩⟩⟩
  show (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
      (homOfLE (h.trans hWU)).op
      ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v) =
    (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map (homOfLE h).op
      ((Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map (homOfLE hWU).op
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v))
  exact _root_.PresheafOfModules.map_comp_apply
    (M := ((Scheme.Modules.pullback f).obj V).val) (homOfLE hWU).op (homOfLE h).op
    ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v)

/-- Unit sections restrict compatibly: the unit section from `U` restricted to a smaller
open is the unit section of the restricted section. -/
lemma unit_app_restrict {U U' : S.Opens} (h : U' ≤ U) (v : Γ(V, U)) :
    (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE ((Opens.map f.base).map (homOfLE h)).le).op
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v) =
      (((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U')
        ((Scheme.Modules.presheaf V).map (homOfLE h).op v) := by
  exact (_root_.PresheafOfModules.naturality_apply
    ((SheafOfModules.forget _).map
      ((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V))
    (homOfLE h).op v).symm

/-- A finite family of unit sections comes from a common open of the base. -/
lemma exists_common_open_of_unitSet {q : ℕ} {W : T.Opens}
    (g : Fin q → Γ((Scheme.Modules.pullback f).obj V, W))
    (hg : ∀ i, g i ∈ pullbackUnitSet f V W) :
    ∃ (U : S.Opens) (h : W ≤ f ⁻¹ᵁ U) (v : Fin q → Γ(V, U)), ∀ i,
      g i = (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE h).op
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) (v i)) := by
  classical
  have hchoice : ∀ i, ∃ (U : S.Opens) (h : W ≤ f ⁻¹ᵁ U) (v : Γ(V, U)),
      g i = (Scheme.Modules.presheaf ((Scheme.Modules.pullback f).obj V)).map
        (homOfLE h).op
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) v) := by
    intro i
    obtain ⟨SU, ⟨U, rfl⟩, hSU⟩ := hg i
    obtain ⟨SV, ⟨hWU, rfl⟩, ⟨v, hv⟩⟩ := hSU
    exact ⟨U, hWU, v, hv.symm⟩
  choose U hU v hv using hchoice
  refine ⟨⨅ i, U i, ?_, fun i ↦ (Scheme.Modules.presheaf V).map
    (homOfLE (iInf_le U i)).op (v i), fun i ↦ ?_⟩
  · intro y hy
    show f.base y ∈ ((⨅ i, U i : S.Opens) : Set S)
    rw [TopologicalSpace.Opens.coe_iInf]
    exact Set.mem_iInter.mpr fun i ↦ hU i hy
  · have hle : (⨅ i, U i) ≤ U i := iInf_le U i
    have hWinf : W ≤ f ⁻¹ᵁ (⨅ i, U i) := by
      intro y hy
      show f.base y ∈ ((⨅ j, U j : S.Opens) : Set S)
      rw [TopologicalSpace.Opens.coe_iInf]
      exact Set.mem_iInter.mpr fun j ↦ hU j hy
    have hnat := unit_app_restrict f V hle (v i)
    have hcomp := _root_.PresheafOfModules.map_comp_apply
      (M := ((Scheme.Modules.pullback f).obj V).val)
      (homOfLE ((Opens.map f.base).map (homOfLE hle)).le).op (homOfLE hWinf).op
      ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app (U i)) (v i))
    rw [hv i]
    refine Eq.trans ?_ (congrArg (ConcreteCategory.hom
      (((_root_.PresheafOfModules.toPresheaf _).obj
        ((Scheme.Modules.pullback f).obj V).val).map (homOfLE hWinf).op)) hnat)
    exact hcomp


/-- **Extensionality for morphisms out of a pullback**: two morphisms agreeing on all
unit sections are equal. -/
lemma hom_ext_of_unit {K : T.Modules}
    (a b : (Scheme.Modules.pullback f).obj V ⟶ K)
    (h : ∀ (U : S.Opens) (s : Γ(V, U)),
      (a.app (f ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s) =
        (b.app (f ⁻¹ᵁ U))
          ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s)) :
    a = b := by
  have hzero : a - b = 0 := by
    refine eq_zero_of_unit_sections_zero f V (a - b) ?_
    intro U s
    have happ : ((a - b).app (f ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s) =
        (a.app (f ⁻¹ᵁ U))
            ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s) -
          (b.app (f ⁻¹ᵁ U))
            ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app V).app U) s) := rfl
    rw [happ, h U s, sub_self]
  exact sub_eq_zero.mp hzero


section PullbackExteriorPowerEpi

variable (q : ℕ)

/-- The pullback comparison, evaluated on unit sections of the exterior power, is the
wedge comparison. -/
lemma pullbackExteriorPower_app_unit (U : S.Opens)
    (w : (⋀[Γ(S, U)]^q Γ(V, U) :
      Submodule Γ(S, U) (ExteriorAlgebra Γ(S, U) Γ(V, U)))) :
    ((pullbackExteriorPower f V q).app (f ⁻¹ᵁ U))
        ((((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
          (Scheme.Modules.exteriorPower V q)).app U)
          (((Scheme.Modules.toExteriorPower V q).app (Opposite.op U)).hom w)) =
      pullbackWedgeApp f V q U w := by
  -- the transpose relation: `homEquiv P = C`
  have htr : (Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv
      (Scheme.Modules.exteriorPower V q)
      (Scheme.Modules.exteriorPower ((Scheme.Modules.pullback f).obj V) q)
      (pullbackExteriorPower f V q) = exteriorPowerPushforwardComparison f V q := by
    rw [pullbackExteriorPower, Equiv.apply_symm_apply]
  have hcomp := (Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv_unit
    (X := Scheme.Modules.exteriorPower V q)
    (Y := Scheme.Modules.exteriorPower ((Scheme.Modules.pullback f).obj V) q)
    (f := pullbackExteriorPower f V q)
  rw [hcomp] at htr
  -- evaluate at `U` on the unit-of-sheafification of `w`
  have hev := CategoryTheory.congr_fun (congrArg
    (fun (k : Scheme.Modules.exteriorPower V q ⟶
        (Scheme.Modules.pushforward f).obj
          (Scheme.Modules.exteriorPower ((Scheme.Modules.pullback f).obj V) q)) ↦
      k.app U) htr)
    (((Scheme.Modules.toExteriorPower V q).app (Opposite.op U)).hom w)
  refine Eq.trans ?_ (Eq.trans hev ?_)
  · rfl
  · -- the comparison is the sheafification transpose of the wedge comparison
    have hfac := _root_.PresheafOfModules.comp_toPresheaf_map_sheafifyHomEquiv'_symm_hom
      (𝟙 S.ringCatSheaf.val)
      (CategoryTheory.toSheafify (Opens.grothendieckTopology S)
        (Scheme.Modules.exteriorPowerPresheaf V q).presheaf)
      ((Scheme.Modules.pushforward f).obj
        (Scheme.Modules.exteriorPower ((Scheme.Modules.pullback f).obj V) q)).isSheaf
      (pullbackWedge f V q)
    exact CategoryTheory.congr_fun (NatTrans.congr_app hfac (Opposite.op U)) w

