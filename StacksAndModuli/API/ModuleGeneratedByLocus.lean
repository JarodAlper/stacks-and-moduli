module

public import StacksAndModuli.API.ModuleFibreRank
public import StacksAndModuli.API.ModuleFreeRankLocus
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# The open locus where a module is generated by at most `r` elements

For a finite module `M` over a commutative ring `R`, the set of primes at which `M` needs at
most `r` generators is the complement of the vanishing locus of the ideal

`genByIdeal R M r = ⟨ f : f • M ⊆ ⟨g₁, …, g_r⟩ for some g₁, …, g_r ∈ M ⟩`,

which plays the role of the Fitting ideal `Fit_r(M)` of Stacks 05P8 (2) without requiring
determinantal ideals.  Its universal property — an `R`-algebra `A` has `Fit_r(M)·A = A`
exactly when every fibre of `A ⊗ M` has dimension at most `r` — comes from the fact that
fibre rank is a base-change invariant (`Module.fibreFinrank_baseChange`).

Together with `StacksAndModuli/API/ModuleFreeRankLocus.lean` this gives the affine flattening
stratification for one rank: the locus is covered by the basic opens `D(f)` on which `M`
acquires a genuine `r`-element presentation, and on each of those the stratum is the closed
subscheme cut out by the relation ideal.

Main declarations:

* `Module.genByIdeal`;
* `Module.genByIdeal_notLe_iff_fibreFinrank_le`;
* `Module.map_genByIdeal_eq_top_iff` — the universal property of the open locus;
* `Module.surjective_baseChangeMap_of_smul_mem_span` — on `D(f)` the module acquires an
  `r`-element presentation, which is what feeds `Module.freeRankLocus`.
-/

@[expose] public section

noncomputable section

-- These options are load-bearing throughout the library.
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false

open TensorProduct

universe u v

namespace Module

variable (R : Type u) [CommRing R] (M : Type v) [AddCommGroup M] [Module R M] (r : ℕ)

/-- The set of scalars `f` for which `f • M` lies in a submodule generated by at most `r`
elements. -/
def genBySet : Set R :=
  {f : R | ∃ g : Fin r → M, ∀ m : M, f • m ∈ Submodule.span R (Set.range g)}

/-- The ideal generated by `Module.genBySet`.  Its basic opens cover the locus where `M`
needs at most `r` generators; it is the Fitting ideal `Fit_r(M)` in the sense of
Stacks 05P8 (2), described without determinants. -/
def genByIdeal : Ideal R :=
  Ideal.span (genBySet R M r)

variable {R M r}

theorem mem_genBySet_iff {f : R} :
    f ∈ genBySet R M r ↔
      ∃ g : Fin r → M, ∀ m : M, f • m ∈ Submodule.span R (Set.range g) :=
  Iff.rfl

theorem subset_genByIdeal : genBySet R M r ⊆ (genByIdeal R M r : Set R) :=
  Ideal.subset_span

/-- At a prime `p`, the ideal `genByIdeal` escapes `p` exactly when the fibre of `M` at `p`
has dimension at most `r` — that is, exactly when `M_p` needs at most `r` generators. -/
theorem genByIdeal_notLe_iff_fibreFinrank_le [Module.Finite R M] (p : PrimeSpectrum R) :
    ¬ genByIdeal R M r ≤ p.asIdeal ↔ fibreFinrank R M p ≤ r := by
  constructor
  · intro h
    obtain ⟨f, hfS, hfp⟩ : ∃ f ∈ genBySet R M r, f ∉ p.asIdeal := by
      by_contra hcon
      push Not at hcon
      exact h (Ideal.span_le.mpr hcon)
    obtain ⟨g, hg⟩ := hfS
    exact fibreFinrank_le_of_smul_mem_span hfp g hg
  · intro h hle
    obtain ⟨f, hfp, g, hg⟩ := exists_smul_mem_span_of_fibreFinrank_le h
    exact hfp (hle (subset_genByIdeal ⟨g, hg⟩))

/-- **The universal property of the open locus.**  For an `R`-algebra `A`, the extension of
`genByIdeal` is the unit ideal exactly when every fibre of `A ⊗ M` has dimension at most `r`
— that is, exactly when `Spec A → Spec R` factors through the open locus.

This is Stacks 05P8 (2): the functor `T ↦ {∗ if M_T is locally generated by ≤ r sections}`
is represented by the open subscheme `Spec R ∖ V(Fit_r(M))`. -/
theorem map_genByIdeal_eq_top_iff [Module.Finite R M]
    (A : Type u) [CommRing A] [Algebra R A] :
    (genByIdeal R M r).map (algebraMap R A) = ⊤ ↔
      ∀ q : PrimeSpectrum A, fibreFinrank A (A ⊗[R] M) q ≤ r := by
  constructor
  · intro h q
    rw [fibreFinrank_baseChange, ← genByIdeal_notLe_iff_fibreFinrank_le]
    intro hle
    have : (genByIdeal R M r).map (algebraMap R A) ≤ q.asIdeal :=
      Ideal.map_le_iff_le_comap.mpr hle
    rw [h, top_le_iff] at this
    exact q.isPrime.ne_top this
  · intro h
    by_contra hne
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
    haveI : m.IsPrime := hm.isPrime
    have hfib := h ⟨m, inferInstance⟩
    rw [fibreFinrank_baseChange, ← genByIdeal_notLe_iff_fibreFinrank_le] at hfib
    exact hfib (Ideal.map_le_iff_le_comap.mp hle)

section Presentation

variable {ι : Type*} [Fintype ι]

/-- The linear map `Rⁱ → M` attached to a family of elements of `M`. -/
def familyMap (g : ι → M) : (ι → R) →ₗ[R] M :=
  Fintype.linearCombination R g

@[simp]
theorem familyMap_apply (g : ι → M) (c : ι → R) :
    familyMap g c = ∑ i, c i • g i := rfl

@[simp]
theorem familyMap_single [DecidableEq ι] (g : ι → M) (i : ι) :
    familyMap g (Pi.single i (1 : R)) = g i := by
  simp [familyMap, Fintype.linearCombination_apply_single]

/-- **On `D(f)` the module acquires an `r`-element presentation.**  If `f • M` lies in the
span of `g : Fin r → M`, then over any `R`-algebra in which `f` becomes a unit the canonical
map `Aʳ → A ⊗ M` is surjective.

This is what turns the open locus into a cover on whose members
`Module.freeRankLocus` applies. -/
theorem surjective_baseChangeMap_of_smul_mem_span {g : Fin r → M} {f : R}
    (h : ∀ m : M, f • m ∈ Submodule.span R (Set.range g))
    (A : Type u) [CommRing A] [Algebra R A] (hf : IsUnit (algebraMap R A f)) :
    Function.Surjective (baseChangeMap A (familyMap (R := R) g)) := by
  classical
  obtain ⟨u, hu⟩ := hf
  rw [← LinearMap.range_eq_top]
  refine top_le_iff.mp ?_
  rw [← span_one_tmul_eq_top R M A]
  refine Submodule.span_le.mpr ?_
  rintro y ⟨m, rfl⟩
  -- `1 ⊗ (f • m)` lies in the range, since `f • m` is an `R`-combination of the `g i`.
  have hgi : ∀ i, (1 : A) ⊗ₜ[R] g i ∈ LinearMap.range (baseChangeMap A (familyMap (R := R) g)) :=
    fun i ↦ ⟨Pi.single i 1, by rw [baseChangeMap_single, familyMap_single]⟩
  have hfm : (1 : A) ⊗ₜ[R] (f • m) ∈
      LinearMap.range (baseChangeMap A (familyMap (R := R) g)) := by
    have := tmul_mem_span_of_mem_span (k := A) g (h m)
    refine Submodule.span_le.mpr ?_ this
    rintro y ⟨i, rfl⟩
    exact hgi i
  have hsm : (1 : A) ⊗ₜ[R] (f • m) = algebraMap R A f • ((1 : A) ⊗ₜ[R] m) := by
    rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', TensorProduct.smul_tmul',
      smul_eq_mul, mul_one, Algebra.smul_def, mul_one]
  rw [hsm, ← hu] at hfm
  have h2 := (LinearMap.range (baseChangeMap A (familyMap (R := R) g))).smul_mem
    ((u⁻¹ : Aˣ) : A) hfm
  rw [smul_smul, Units.inv_mul, one_smul] at h2
  exact h2

end Presentation

section Flattening

/-- **The flat-of-rank-`r` locus lies inside the open locus.**  If `A ⊗ M` is flat over `A`
with all stalk ranks equal to `r`, then `Spec A → Spec R` factors through the open subscheme
where `M` needs at most `r` generators.

This is the step of the flattening stratification which says that the stratum `S_r` is a
*closed* subscheme of the open `Spec R ∖ V(Fit_r(M))`, not merely a locally closed subset:
the flatness condition already forces the test object into the open. -/
theorem map_genByIdeal_eq_top_of_flat_of_rankAtStalk [Module.Finite R M]
    (A : Type u) [CommRing A] [Algebra R A] [Module.Flat A (A ⊗[R] M)]
    (hrank : ∀ q : PrimeSpectrum A, Module.rankAtStalk (A ⊗[R] M) q = r) :
    (genByIdeal R M r).map (algebraMap R A) = ⊤ := by
  refine (map_genByIdeal_eq_top_iff A).mpr fun q ↦ ?_
  haveI : Module.Finite A (A ⊗[R] M) := inferInstance
  rw [fibreFinrank_eq_rankAtStalk A (A ⊗[R] M) q, hrank q]

end Flattening

end Module

end

end
