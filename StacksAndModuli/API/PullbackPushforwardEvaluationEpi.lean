module

public import StacksAndModuli.API.FiniteFreePresentationVanishingModel

/-!
# Epimorphic pullback--pushforward evaluation from global generators

If a module sheaf is generated by a family of global sections, the corresponding
free-sheaf map factors through the counit `f^* f_* M ⟶ M`.  Since that free-sheaf map
is epimorphic, the counit is epimorphic as well.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Modules

/-- A morphism from a pullback is epimorphic when its adjoint is an isomorphism and the
pullback--pushforward counit of its target is epimorphic. -/
theorem epi_of_isIso_pullbackPushforwardAdjunct_of_counit_epi
    {X Y : Scheme.{u}} (f : X ⟶ Y) {A : Y.Modules} {B : X.Modules}
    (k : (pullback f).obj A ⟶ B)
    [IsIso ((pullbackPushforwardAdjunction f).homEquiv A B k)]
    [Epi ((pullbackPushforwardAdjunction f).counit.app B)] : Epi k := by
  have hk : k = (pullback f).map
        ((pullbackPushforwardAdjunction f).homEquiv A B k) ≫
      (pullbackPushforwardAdjunction f).counit.app B := by
    calc
      k = ((pullbackPushforwardAdjunction f).homEquiv A B).symm
          ((pullbackPushforwardAdjunction f).homEquiv A B k) :=
        (Equiv.symm_apply_apply _ k).symm
      _ = _ := (pullbackPushforwardAdjunction f).homEquiv_counit A B
        ((pullbackPushforwardAdjunction f).homEquiv A B k)
  rw [hk]
  infer_instance

/-- A globally generating family makes the pullback--pushforward evaluation
epimorphic. -/
theorem pullbackPushforwardCounit_epi_of_freeHomOfSections
    {X Y : Scheme.{u}} (f : X ⟶ Y) {I : Type u} (M : X.Modules)
    (s : I → Γ(M, ⊤)) [Epi (freeHomOfSections s)] :
    Epi ((pullbackPushforwardAdjunction f).counit.app M) := by
  let sY : I → Γ((pushforward f).obj M, ⊤) := s
  let b := freeHomOfSections sY
  let a := (pullbackFreeIso f I).inv ≫ (pullback f).map b
  let ε := (pullbackPushforwardAdjunction f).counit.app M
  have hfac : a ≫ ε = freeHomOfSections s := by
    dsimp only [a, b, ε]
    apply pullback_freeHomOfSections_comp_of_sections
    intro i
    have hpull :
        Scheme.Modules.pullbackGlobalSections f ((pushforward f).obj M)
            (show Γ((pushforward f).obj M, ⊤) from s i) =
          ((pullbackPushforwardAdjunction f).unit.app
            ((pushforward f).obj M)).app ⊤
            (show Γ((pushforward f).obj M, ⊤) from s i) := rfl
    rw [hpull]
    have htri := (pullbackPushforwardAdjunction f).right_triangle_components M
    have happ := congrArg
      (fun k : (pushforward f).obj M ⟶ (pushforward f).obj M ↦
        Hom.app k ⊤ (show Γ((pushforward f).obj M, ⊤) from s i)) htri
    exact happ
  haveI : Epi (a ≫ ε) := hfac ▸ inferInstance
  exact epi_of_epi a ε

end AlgebraicGeometry.Scheme.Modules

end

end
