section ExAffineLineWhereResidueFieldJumps

open CategoryTheory Limits AlgebraicGeometry

namespace AlgebraicGeometry

/-- Complex conjugation on the affine line $\bA^1_{\bC}$ over $\Spec \bR$: the morphism
induced by functoriality of affine space from the conjugation automorphism of
$\Spec \bC$. It fixes the coordinate and conjugates the scalars; it is an automorphism of
$\bA^1_{\bC}$ over $\Spec \bR$ (but not over $\Spec \bC$). -/
noncomputable def complexConjAffineLine :
    𝔸(PUnit; Spec (CommRingCat.of ℂ)) ⟶ 𝔸(PUnit; Spec (CommRingCat.of ℂ)) :=
  AffineSpace.map PUnit (Spec.map (CommRingCat.ofHom (starRingEnd ℂ)))

/-- Complex conjugation on the affine line $\bA^1_{\bC}$ is an involution. -/
@[reassoc]
lemma complexConjAffineLine_comp_self :
    complexConjAffineLine ≫ complexConjAffineLine = 𝟙 _ := by
  have h : CommRingCat.ofHom (starRingEnd ℂ) ≫ CommRingCat.ofHom (starRingEnd ℂ) =
      𝟙 (CommRingCat.of ℂ) := by
    ext z
    exact star_star z
  rw [complexConjAffineLine, ← AffineSpace.map_comp, ← Spec.map_comp, h, Spec.map_id,
    AffineSpace.map_id]

/- Complex conjugation on the affine line is an isomorphism (its own inverse). -/
instance : IsIso complexConjAffineLine :=
  ⟨complexConjAffineLine, complexConjAffineLine_comp_self,
    complexConjAffineLine_comp_self⟩

/-- Background construction used in Exercise 4.9.7: the family of open subschemes of
$\bA^1_{\bC}$ underlying the
conjugation equivalence relation $R = (\bZ/2 \times \bA^1_{\bC}) \setminus \{(-1, 0)\}$:
all of $\bA^1_{\bC}$ for the identity component (`false`), and the complement of the
origin for the conjugation component (`true`). -/
noncomputable def complexConjRelOpens : Bool → (𝔸(PUnit; Spec (CommRingCat.of ℂ))).Opens
  | false => ⊤
  | true =>
    (𝔸(PUnit; Spec (CommRingCat.of ℂ))).basicOpen
      (AffineSpace.coord (Spec (CommRingCat.of ℂ)) PUnit.unit)

/-- Background construction used in Exercise 4.9.7: the identity on all of
$\bA^1_{\bC}$ (`false`)
and complex conjugation on the complement of the origin (`true`). -/
noncomputable def complexConjRelAut :
    Bool → (𝔸(PUnit; Spec (CommRingCat.of ℂ)) ⟶ 𝔸(PUnit; Spec (CommRingCat.of ℂ)))
  | false => 𝟙 _
  | true => complexConjAffineLine

/- The second projection of the conjugation relation is étale. Registered as an instance
(keyed to the specific defs). -/
instance : Etale (Scheme.partialEndRelSnd complexConjRelOpens complexConjRelAut) :=
  Scheme.etale_partialEndRelSnd _ _ fun b ↦ by
    cases b <;> dsimp only [complexConjRelAut] <;> infer_instance

/-- Background definition used in Exercise 4.9.7: the quotient presheaf
$\bA^1_{\bC}/R$ of the
conjugation equivalence relation
$R = (\bZ/2 \times \bA^1_{\bC}) \setminus \{(-1, 0)\} \rightrightarrows \bA^1_{\bC}$
induced by the $\bZ/2$-action on $\bA^1_{\bC}$ by conjugation over $\Spec \bR$. Its étale
sheafification is an algebraic space which looks like $\bA^1_{\bR}$ except that the
origin has residue field $\bC$ (Figure 4.9.8); it is not a
scheme. -/
noncomputable abbrev complexConjQuotientPresheaf : Scheme.{0}ᵒᵖ ⥤ Type :=
  Scheme.partialEndQuotientPresheaf complexConjRelOpens complexConjRelAut

namespace ComplexConjCover

/- The following construction equips the two-component conjugation relation with its
groupoid structure.  The identity component is the affine line, while conjugation
restricts to an involution of the punctured component. -/

lemma conj_preserves_relOpen :
    complexConjRelOpens true ≤
      complexConjAffineLine ⁻¹ᵁ complexConjRelOpens true := by
  rw [show complexConjRelOpens true =
    (𝔸(PUnit; Spec (CommRingCat.of ℂ))).basicOpen
      (AffineSpace.coord (Spec (CommRingCat.of ℂ)) PUnit.unit) by rfl]
  rw [Scheme.preimage_basicOpen_top]
  rw [complexConjAffineLine, AffineSpace.map_appTop_coord]

noncomputable def identity :
    𝔸(PUnit; Spec (CommRingCat.of ℂ)) ⟶
      ∐ fun b ↦ (complexConjRelOpens b).toScheme :=
  (((𝔸(PUnit; Spec (CommRingCat.of ℂ))).isoOfEq
    (show complexConjRelOpens false = ⊤ by rfl)).trans
      (𝔸(PUnit; Spec (CommRingCat.of ℂ))).topIso).inv ≫
        Sigma.ι (fun b ↦ (complexConjRelOpens b).toScheme) false

noncomputable def conjRestriction :
    (complexConjRelOpens true).toScheme ⟶
      (complexConjRelOpens true).toScheme :=
  Scheme.Hom.resLE complexConjAffineLine
    (complexConjRelOpens true) (complexConjRelOpens true)
    conj_preserves_relOpen

noncomputable def inverse :
    (∐ fun b ↦ (complexConjRelOpens b).toScheme) ⟶
      ∐ fun b ↦ (complexConjRelOpens b).toScheme :=
  Sigma.desc fun b ↦ match b with
    | false => Sigma.ι (fun b ↦ (complexConjRelOpens b).toScheme) false
    | true => conjRestriction ≫
        Sigma.ι (fun b ↦ (complexConjRelOpens b).toScheme) true

lemma identity_source : identity ≫
    Scheme.partialEndRelFst complexConjRelOpens = 𝟙 _ := by
  simp [identity, Scheme.partialEndRelFst]
  simpa only [complexConjRelOpens] using
    Scheme.toIso_inv_ι (𝔸(PUnit; Spec (CommRingCat.of ℂ)))

lemma identity_target : identity ≫
    Scheme.partialEndRelSnd complexConjRelOpens complexConjRelAut = 𝟙 _ := by
  simp [identity, Scheme.partialEndRelSnd, complexConjRelAut]
  simpa only [complexConjRelOpens] using
    Scheme.toIso_inv_ι (𝔸(PUnit; Spec (CommRingCat.of ℂ)))

@[reassoc]
lemma conjRestriction_comp_ι : conjRestriction ≫
    (complexConjRelOpens true).ι =
      (complexConjRelOpens true).ι ≫ complexConjAffineLine := by
  simpa only [conjRestriction] using
    Scheme.Hom.resLE_comp_ι complexConjAffineLine conj_preserves_relOpen

lemma inverse_source : inverse ≫
    Scheme.partialEndRelFst complexConjRelOpens =
      Scheme.partialEndRelSnd complexConjRelOpens complexConjRelAut := by
  dsimp only [Scheme.partialEndRelFst, Scheme.partialEndRelSnd,
    Scheme.partialEndRel]
  apply Sigma.hom_ext
  intro b
  cases b <;>
    simp [inverse, complexConjRelAut, conjRestriction_comp_ι]

lemma inverse_target : inverse ≫
    Scheme.partialEndRelSnd complexConjRelOpens complexConjRelAut =
      Scheme.partialEndRelFst complexConjRelOpens := by
  dsimp only [Scheme.partialEndRelFst, Scheme.partialEndRelSnd,
    Scheme.partialEndRel]
  apply Sigma.hom_ext
  intro b
  cases b <;>
    simp [inverse, complexConjRelAut, conjRestriction_comp_ι_assoc,
      complexConjAffineLine_comp_self]

noncomputable abbrev A : Scheme :=
  𝔸(PUnit; Spec (CommRingCat.of ℂ))

noncomputable abbrev U (b : Bool) : A.Opens :=
  complexConjRelOpens b

noncomputable abbrev sourceComponent (b : Bool) :
    (U b).toScheme ⟶ A :=
  (U b).ι

noncomputable abbrev targetComponent (b : Bool) :
    (U b).toScheme ⟶ A :=
  (U b).ι ≫ complexConjRelAut b

noncomputable def pullbackComparison :
    (∐ fun p : Bool × Bool ↦
      pullback (sourceComponent p.1) (targetComponent p.2)) ⟶
      pullback (Sigma.desc sourceComponent) (Sigma.desc targetComponent) :=
  Sigma.desc fun p ↦
    pullback.map (sourceComponent p.1) (targetComponent p.2)
      (Sigma.desc sourceComponent) (Sigma.desc targetComponent)
      (Sigma.ι (fun b ↦ (U b).toScheme) p.1)
      (Sigma.ι (fun b ↦ (U b).toScheme) p.2)
      (𝟙 _) (by simp) (by simp)

instance : IsIso pullbackComparison := by
  apply CategoryTheory.FinitaryPreExtensive.isIso_sigmaDesc_map

noncomputable def toIdentityComponent :
    (U true).toScheme ⟶ (U false).toScheme :=
  (U true).ι ≫
    ((A.isoOfEq (show U false = ⊤ by rfl)).trans A.topIso).inv

@[reassoc]
lemma toIdentityComponent_comp_ι : toIdentityComponent ≫
    (U false).ι = (U true).ι := by
  simp [toIdentityComponent]
  change (U true).ι ≫ A.topIso.inv ≫ (⊤ : A.Opens).ι = (U true).ι
  simp

noncomputable def compositionComponent (p : Bool × Bool) :
    pullback (sourceComponent p.1) (targetComponent p.2) ⟶
      ∐ fun b ↦ (U b).toScheme :=
  match p with
  | (false, false) =>
      pullback.snd _ _ ≫ Sigma.ι (fun b ↦ (U b).toScheme) false
  | (false, true) =>
      pullback.snd _ _ ≫ Sigma.ι (fun b ↦ (U b).toScheme) true
  | (true, false) =>
      pullback.fst _ _ ≫ Sigma.ι (fun b ↦ (U b).toScheme) true
  | (true, true) =>
      pullback.snd _ _ ≫ toIdentityComponent ≫
        Sigma.ι (fun b ↦ (U b).toScheme) false

noncomputable def composition :
    pullback (Sigma.desc sourceComponent) (Sigma.desc targetComponent) ⟶
      ∐ fun b ↦ (U b).toScheme :=
  inv pullbackComparison ≫ Sigma.desc compositionComponent

lemma composition_source : composition ≫ Sigma.desc sourceComponent =
    pullback.snd (Sigma.desc sourceComponent) (Sigma.desc targetComponent) ≫
      Sigma.desc sourceComponent := by
  rw [← cancel_epi pullbackComparison]
  apply Sigma.hom_ext
  rintro ⟨a, b⟩
  cases a <;> cases b <;>
    simp [composition, pullbackComparison, compositionComponent,
      sourceComponent, targetComponent, toIdentityComponent_comp_ι,
      complexConjRelAut, Category.assoc, pullback.condition]

lemma composition_target : composition ≫ Sigma.desc targetComponent =
    pullback.fst (Sigma.desc sourceComponent) (Sigma.desc targetComponent) ≫
      Sigma.desc targetComponent := by
  rw [← cancel_epi pullbackComparison]
  apply Sigma.hom_ext
  rintro ⟨a, b⟩
  cases a <;> cases b <;>
    simp [composition, pullbackComparison, compositionComponent,
      sourceComponent, targetComponent, toIdentityComponent_comp_ι,
      complexConjRelAut, Category.assoc, pullback.condition,
      pullback.condition_assoc, complexConjAffineLine_comp_self]

/- Complex conjugation has no fixed geometric point: a fixed map would induce an
injective field homomorphism from $\mathbb C$ on which conjugation acts trivially. -/
lemma no_fixed_point {K : Type} [Field K]
    (f : Spec (CommRingCat.of K) ⟶ A)
    (hfix : f ≫ complexConjAffineLine = f) : False := by
  let p : A ⟶ Spec (CommRingCat.of ℂ) := A ↘ Spec (CommRingCat.of ℂ)
  have hp := congrArg (fun q : Spec (CommRingCat.of K) ⟶ A ↦ q ≫ p) hfix
  have hp' : (f ≫ p) ≫ Spec.map (CommRingCat.ofHom (starRingEnd ℂ)) = f ≫ p := by
    simpa [A, p, complexConjAffineLine, Category.assoc] using hp
  have happ := congrArg Scheme.Hom.appTop hp'
  change (Spec.map (CommRingCat.ofHom (starRingEnd ℂ))).appTop ≫
    (f ≫ p).appTop = (f ≫ p).appTop at happ
  let φ : CommRingCat.of ℂ ⟶ CommRingCat.of K :=
    (Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv ≫
      (f ≫ p).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom
  have hφ : CommRingCat.ofHom (starRingEnd ℂ) ≫ φ = φ := by
    dsimp only [φ]
    simp only [← Category.assoc]
    rw [Scheme.ΓSpecIso_inv_naturality]
    rw [Category.assoc (Scheme.ΓSpecIso (CommRingCat.of ℂ)).inv]
    rw [happ]
  have hφI := ConcreteCategory.congr_hom hφ (Complex.I : ℂ)
  have hstar : starRingEnd ℂ Complex.I = Complex.I := by
    apply RingHom.injective φ.hom
    exact hφI
  have him := congrArg Complex.im hstar
  norm_num at him

noncomputable abbrev relationMap :
    (∐ fun b ↦ (U b).toScheme) ⟶ A ⨯ A :=
  prod.lift (Sigma.desc sourceComponent) (Sigma.desc targetComponent)

lemma field_injective (K : Type) [Field K] :
    Function.Injective (fun x : Spec (CommRingCat.of K) ⟶
      ∐ fun b ↦ (U b).toScheme ↦ x ≫ relationMap) := by
  intro x y hxy
  have hs : x ≫ Sigma.desc sourceComponent =
      y ≫ Sigma.desc sourceComponent := by
    simpa [relationMap] using congrArg (fun q ↦ q ≫ prod.fst) hxy
  have ht : x ≫ Sigma.desc targetComponent =
      y ≫ Sigma.desc targetComponent := by
    simpa [relationMap] using congrArg (fun q ↦ q ≫ prod.snd) hxy
  -- At `k = ℂ` the two open families are definitionally the same; reuse the
  -- universe-safe finite-coproduct component decomposition constructed above.
  generalize hbx : BugEyedCover.component (k := ℂ) x = bx
  generalize hby : BugEyedCover.component (k := ℂ) y = cy
  let xl := BugEyedCover.componentLiftAt (k := ℂ) x bx hbx
  let yl := BugEyedCover.componentLiftAt (k := ℂ) y cy hby
  have hxf := BugEyedCover.componentLiftAt_fac (k := ℂ) x bx hbx
  have hyf := BugEyedCover.componentLiftAt_fac (k := ℂ) y cy hby
  rw [← hxf, ← hyf] at hs ht
  simp only [Category.assoc, Sigma.ι_desc] at hs ht
  cases bx <;> cases cy
  · have hLift : xl = yl := by
      apply (cancel_mono (U false).ι).mp
      exact hs
    rw [← hxf, ← hyf]
    change xl ≫ Sigma.ι (fun b ↦ (U b).toScheme) false =
      yl ≫ Sigma.ι (fun b ↦ (U b).toScheme) false
    rw [hLift]
  · have hfix : (yl ≫ (U true).ι) ≫ complexConjAffineLine =
        yl ≫ (U true).ι := by
      rw [Category.assoc]
      exact (by simpa only [targetComponent, complexConjRelAut,
        Category.comp_id] using ht.symm.trans hs)
    exact (no_fixed_point (yl ≫ (U true).ι) hfix).elim
  · have hfix : (xl ≫ (U true).ι) ≫ complexConjAffineLine =
        xl ≫ (U true).ι := by
      rw [Category.assoc]
      exact (by simpa only [targetComponent, complexConjRelAut,
        Category.comp_id] using ht.trans hs.symm)
    exact (no_fixed_point (xl ≫ (U true).ι) hfix).elim
  · have hLift : xl = yl := by
      apply (cancel_mono (U true).ι).mp
      exact hs
    rw [← hxf, ← hyf]
    change xl ≫ Sigma.ι (fun b ↦ (U b).toScheme) true =
      yl ≫ Sigma.ι (fun b ↦ (U b).toScheme) true
    rw [hLift]

lemma universallyInjective_relationMap :
    UniversallyInjective relationMap := by
  exact ((tfae_universallyInjective relationMap).out 0 1).mpr field_injective

lemma mono_relationMap : Mono relationMap := by
  let f := relationMap
  have hf_fst : f ≫ prod.fst = Sigma.desc sourceComponent := by
    simp [f, relationMap]
  haveI : UniversallyInjective f := universallyInjective_relationMap
  haveI : LocallyOfFiniteType (f ≫ prod.fst) := by
    rw [hf_fst]
    exact IsZariskiLocalAtSource.sigmaDesc fun _ ↦ inferInstance
  haveI : LocallyOfFiniteType f := locallyOfFiniteType_of_comp f prod.fst
  haveI : FormallyUnramified (f ≫ prod.fst) := by
    rw [hf_fst]
    exact IsZariskiLocalAtSource.sigmaDesc fun _ ↦ inferInstance
  haveI : FormallyUnramified f := FormallyUnramified.of_comp f prod.fst
  haveI : Surjective (pullback.diagonal f) :=
    ((tfae_universallyInjective f).out 0 3).mp universallyInjective_relationMap
  haveI : IsIso (pullback.diagonal f) :=
    (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, inferInstance⟩
  exact (pullback.isIso_diagonal_iff f).mp inferInstance

lemma relation_unique {T : Scheme}
    (x y : T ⟶ ∐ fun b ↦ (U b).toScheme)
    (hs : x ≫ Sigma.desc sourceComponent = y ≫ Sigma.desc sourceComponent)
    (ht : x ≫ Sigma.desc targetComponent = y ≫ Sigma.desc targetComponent) : x = y := by
  haveI : Mono relationMap := mono_relationMap
  apply (cancel_mono relationMap).mp
  apply prod.hom_ext
  · simpa [relationMap] using hs
  · simpa [relationMap] using ht

noncomputable def groupoid : PresheafGroupoid.{0} :=
  PresheafGroupoid.ofSchemesOfRelation
    (Sigma.desc sourceComponent) (Sigma.desc targetComponent)
    composition identity inverse composition_source composition_target
    identity_source identity_target inverse_source inverse_target relation_unique

lemma groupoid_isEquivalenceRelation : groupoid.IsEquivalenceRelation :=
  PresheafGroupoid.ofSchemesOfRelation_isEquivalenceRelation
    (Sigma.desc sourceComponent) (Sigma.desc targetComponent)
    composition identity inverse composition_source composition_target
    identity_source identity_target inverse_source inverse_target relation_unique

instance : groupoid.IsEtale := by
  letI : Etale (Sigma.desc sourceComponent) :=
    IsZariskiLocalAtSource.sigmaDesc fun _ ↦ inferInstance
  letI : Etale (Sigma.desc targetComponent) :=
    IsZariskiLocalAtSource.sigmaDesc fun b ↦ by
      cases b <;> dsimp only [targetComponent, complexConjRelAut] <;> infer_instance
  exact PresheafGroupoid.ofSchemesOfRelation_isEtale
    (Sigma.desc sourceComponent) (Sigma.desc targetComponent)
    composition identity inverse composition_source composition_target
    identity_source identity_target inverse_source inverse_target relation_unique

instance : groupoid.U.IsRepresentable := by
  change (yoneda.obj A).IsRepresentable
  infer_instance

instance : groupoid.R.IsRepresentable := by
  change (yoneda.obj (∐ fun b ↦ (U b).toScheme)).IsRepresentable
  infer_instance

end ComplexConjCover

/-- **Exercise 4.9.7** (`ex:affine-line-where-residue-field-jumps`) (the quotient is an
algebraic space): let $X$ be an étale sheafification of the quotient presheaf of the
conjugation equivalence relation $R = (\bZ/2 \times \bA^1_{\bC}) \setminus \{(-1, 0)\}
\rightrightarrows \bA^1_{\bC}$ over $\Spec \bR$. Then $X$ is an algebraic space. -/
theorem isAlgebraicSpace_of_isSheafificationHom_complexConjQuotientPresheaf
    {X : Scheme.{0}ᵒᵖ ⥤ Type} (η : complexConjQuotientPresheaf ⟶ X)
    (hη : Presheaf.IsSheafificationHom Scheme.etaleTopology η) :
    IsAlgebraicSpace X := by
  let G := ComplexConjCover.groupoid
  change coequalizer G.s G.t ⟶ X at η
  change Presheaf.IsSheafificationHom Scheme.etaleTopology η at hη
  have hq := G.isQuotientSheaf_of_isSheafificationHom_coequalizer η hη
  exact G.isAlgebraicSpace_of_isQuotientSheaf
    ComplexConjCover.groupoid_isEquivalenceRelation hq

/-- **Exercise 4.9.7** (`ex:affine-line-where-residue-field-jumps`) (the quotient is not
a scheme): let $X$ be an étale sheafification of the quotient presheaf of the conjugation
equivalence relation on $\bA^1_{\bC}$ over $\Spec \bR$. Then $X$ is not representable by
a scheme: identifying $X$ with the quotient of the non-separated affine line
$U = \bA^1_{\bC} \cup_{\bA^1_{\bC} \setminus 0} \bA^1_{\bC}$ by the $\bZ/2$-action which
conjugates and swaps the origins, an affine neighborhood of the origin of $X$ would pull
back to an affine open of $U$ containing both origins. -/
theorem not_isRepresentable_of_isSheafificationHom_complexConjQuotientPresheaf
    {X : Scheme.{0}ᵒᵖ ⥤ Type} (η : complexConjQuotientPresheaf ⟶ X)
    (hη : Presheaf.IsSheafificationHom Scheme.etaleTopology η) :
    ¬ X.IsRepresentable := by
  sorry

